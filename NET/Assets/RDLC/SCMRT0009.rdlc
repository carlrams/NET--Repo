        <Style />
      </Body>
      <Width>9.55in</Width>
      <Page>
        <PageHeader>
          <Height>1in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="Textbox22">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Warehouse Inventory - Detail Report</Value>
                      <Style>
                        <FontFamily>Tahoma</FontFamily>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <Color>White</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <rd:DefaultName>Textbox22</rd:DefaultName>
              <Top>0.1in</Top>
              <Left>0.1in</Left>
              <Height>0.2in</Height>
              <Width>8.325in</Width>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
                <PaddingLeft>2pt</PaddingLeft>
                <PaddingRight>2pt</PaddingRight>
                <PaddingTop>2pt</PaddingTop>
                <PaddingBottom>2pt</PaddingBottom>
              </Style>
            </Textbox>
            <Textbox Name="Textbox23">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>As of </Value>
                      <Style>
                        <FontFamily>Tahoma</FontFamily>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <Color>White</Color>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value>=iif(Parameters!Period.Value = "1","Jan",iif(Parameters!Period.Value = "2","Feb",iif(Parameters!Period.Value = "3","Mar",iif(Parameters!Period.Value = "4","Apr",iif(Parameters!Period.Value = "5","May",iif(Parameters!Period.Value = "6","Jun",iif(Parameters!Period.Value = "7","Jul",iif(Parameters!Period.Value = "8","Aug",iif(Parameters!Period.Value = "9","Sep",iif(Parameters!Period.Value = "10","Oct",iif(Parameters!Period.Value = "11","Nov","Dec")))))))))))</Value>
                      <Style>
                        <FontFamily>Tahoma</FontFamily>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <Color>White</Color>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value xml:space="preserve"> </Value>
