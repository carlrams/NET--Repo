                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(Fields!JanUnit.Value) + SUM(Fields!FebUnit.Value) + SUM(Fields!MarUnit.Value) + SUM(Fields!AprUnit.Value) + SUM(Fields!MayUnit.Value) + SUM(Fields!JunUnit.Value) + SUM(Fields!JulUnit.Value) + SUM(Fields!AugUnit.Value) + SUM(Fields!SepUnit.Value) + SUM(Fields!OctUnit.Value) + SUM(Fields!NovUnit.Value) + SUM(Fields!DecUnit.Value)</Value>
