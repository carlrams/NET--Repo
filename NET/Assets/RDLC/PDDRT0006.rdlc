                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(Fields!JanTCP.Value) + SUM(Fields!FebTCP.Value) + SUM(Fields!MarTCP.Value) + SUM(Fields!AprTCP.Value) + SUM(Fields!MayTCP.Value) + SUM(Fields!JunTCP.Value) + SUM(Fields!JulTCP.Value) + SUM(Fields!AugTCP.Value) + SUM(Fields!SepTCP.Value) + SUM(Fields!OctTCP.Value) + SUM(Fields!NovTCP.Value) + SUM(Fields!DecTCP.Value)</Value>
