    Function BindView(Posted, From_year, to_year, from_period, to_period, from_jrnldate, to_jrnldate, from_ref, to_ref, from_jrnltype, preparedby)

        Dim RecordList As New List(Of Object)()
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand("Get_JrnlHdr", ConStr)
                Cmd.CommandType = CommandType.StoredProcedure
                ' Add posted parameter
                If Posted = 0 Then

                    'Parameters
                    Cmd.Parameters.AddWithValue("@posted", 0)
                    Cmd.Parameters.AddWithValue("@from_year", "")
                    Cmd.Parameters.AddWithValue("@to_year", "")
                    Cmd.Parameters.AddWithValue("@from_period", "")
                    Cmd.Parameters.AddWithValue("@to_period", "")
                    Cmd.Parameters.AddWithValue("@from_jrnl_date", "")
                    Cmd.Parameters.AddWithValue("@to_jrnl_date", "")
                    Cmd.Parameters.AddWithValue("@from_ref", "")
                    Cmd.Parameters.AddWithValue("@to_ref", "")
                    Cmd.Parameters.AddWithValue("@from_jrnl_desc", "")
                    Cmd.Parameters.AddWithValue("@to_jrnl_desc", "")
                    Cmd.Parameters.AddWithValue("@from_jrnl_type", "")
                    Cmd.Parameters.AddWithValue("@to_jrnl_type", "")
                    Cmd.Parameters.AddWithValue("@prepared_by", "")

                ElseIf Posted = 1 Then
                    'Parameters
                    Cmd.Parameters.AddWithValue("@posted", 1)
                    Cmd.Parameters.AddWithValue("@from_year", IIf(From_year <> "", From_year, 0))
                    Cmd.Parameters.AddWithValue("@to_year", IIf(to_year <> "", to_year, 0))
                    Cmd.Parameters.AddWithValue("@from_period", IIf(from_period <> "", from_period, 0))
                    Cmd.Parameters.AddWithValue("@to_period", IIf(to_period <> "", to_period, 0))
                    Cmd.Parameters.AddWithValue("@from_jrnl_date", from_jrnldate)
                    Cmd.Parameters.AddWithValue("@to_jrnl_date", to_jrnldate)
                    Cmd.Parameters.AddWithValue("@from_ref", from_ref)
                    Cmd.Parameters.AddWithValue("@to_ref", to_ref)
                    Cmd.Parameters.AddWithValue("@from_jrnl_desc", "")
                    Cmd.Parameters.AddWithValue("@to_jrnl_desc", "")
                    Cmd.Parameters.AddWithValue("@from_jrnl_type", from_jrnltype)
                    Cmd.Parameters.AddWithValue("@to_jrnl_type", "")
                    Cmd.Parameters.AddWithValue("@prepared_by", preparedby)

                End If

                ConStr.Open()
                Using DR As SqlDataReader = Cmd.ExecuteReader()
                    While DR.Read()
                        'Add the row to the DataTable
                        Dim link As String = "FIN040100-DTL-" & DR("j_code").ToString() & "-" & DR("post")
                        Dim ID As String = "<a href='" & link & "' class='text-dark'>" & DR("j_code") & "</a>"

                        Dim lock As String = If(DR("lock").ToString() = "1", "1", "0")
                        Dim post As String = If(DR("post").ToString() = "1", "1", "0")
                        Dim rev As String = If(DR("rvrs").ToString() = "1", "1", "0")




                        Dim locked As String = "<div class='form-check form-check-sm form-check-custom form-check-solid' " &
                                                "style='background-color: white; padding-right: 3px; margin-right: 3px; align-content: center'>" &
                                                "<input id='chkSelect' runat='server' class='form-check-input checkBoxAllClass chkSelect' " &
                                                "type='checkbox' " & If(lock = "1", "checked='1'", "0") & " style='pointer-events: none;' />" &
                                                "<span style='display:none;'>" & lock & "</span>" & ' Hidden numeric value
                                                "</div>"

                        Dim postrem As String = "<div class='form-check form-check-sm form-check-custom form-check-solid' " &
                                                "style='background-color: white; padding-right: 3px; margin-right: 3px; align-content: center'>" &
                                                "<input id='chkSelect' runat='server' class='form-check-input checkBoxAllClass chkSelect' " &
