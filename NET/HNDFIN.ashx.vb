    Private Function FIN00001_Show_Generate_check_Info(tran_no As String) As String
        ' Fetch bank list
        Dim banks As List(Of Dictionary(Of String, String)) = New JavaScriptSerializer().Deserialize(Of List(Of Dictionary(Of String, String)))(Getbank())

        Dim bankOptionsHtml As New StringBuilder()
        For Each bank In banks
            bankOptionsHtml.AppendFormat("<option value='{0}'>{1}</option>", bank("Code"), bank("Name"))
        Next
        Dim bankOptions As String = bankOptionsHtml.ToString()

        Dim Query As New StringBuilder()
        Query.Append("SELECT ")
        Query.Append("[A].tran_no [Tranno], [A].p_code [pcode], [A].chk_no [chkno], ")
        Query.Append("[A].chk_date [chkdate], [A].chk_amt [chkamt], ")
        Query.Append("[A].ewt_amt [ewtamt], [A].disc_amt [discamt], [A].net_amt [netamt], ")
        Query.Append("[A].bank [bankcode], [B].bank [bankname] ")
        Query.Append("FROM fin_app_hdr [A] ")
        Query.Append("LEFT JOIN fin_bank [B] ON [A].bank = [B].b_code ")
        Query.Append("WHERE ([A].tran_no = '" & tran_no & "') ")
        Query.Append("ORDER BY [A].p_code")

        Dim RecordInfo As New List(Of Object)()
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString, ConStr)
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader()

                Dim tempList As New List(Of Dictionary(Of String, Object))()
                While DR.Read()
                    Dim row As New Dictionary(Of String, Object)()
                    Dim ewtAmtDecimal As Decimal = Convert.ToDecimal(DR("ewtamt"))
                    Dim discAmtDecimal As Decimal = Convert.ToDecimal(DR("discamt"))
                    Dim netAmtDecimal As Decimal = Convert.ToDecimal(DR("netamt"))
                    row("pcode") = DR("pcode").ToString()
                    row("chk_no_raw") = DR("chkno").ToString()
                    row("chk_date_raw") = If(IsDBNull(DR("chkdate")), "", Convert.ToDateTime(DR("chkdate")).ToString("MM/dd/yyyy"))
                    row("chk_amt_raw") = Convert.ToDecimal(DR("chkamt")).ToString("N2")
                    row("ewt_amt_raw") = ewtAmtDecimal
                    row("disc_amt") = discAmtDecimal
                    row("net_amt") = netAmtDecimal
                    row("bankcode") = DR("bankcode").ToString()
                    tempList.Add(row)
                End While

                Dim totalRows As Integer = tempList.Count
                Dim rowIndex As Integer = 0

                For Each item In tempList
                    Dim isEditable_chk_amt = (totalRows >= 2)
                    Dim isEditable_chk_no = (totalRows >= 2 AndAlso rowIndex > 0)
                    Dim isEditable_chk_date = (totalRows >= 2 AndAlso rowIndex > 0)
                    Dim isEditable_bank = (totalRows >= 2 AndAlso rowIndex > 0)
                    Dim isEditable_ewt_amt = (rowIndex = totalRows - 1)

                    ' chk_amt
                    Dim chkamtHtml = If(isEditable_chk_amt,
                    $"<div contenteditable='true' class='editable text-end input-line' data-field='chk_amt' data-maxlength='21'>{item("chk_amt_raw")}</div>",
                    $"<div class='editable disabled text-end' data-field='chk_amt' style='pointer-events: none;'>{item("chk_amt_raw")}</div>")

                    ' chk_date
                    Dim chkdateHtml = If(isEditable_chk_date,
                    $"<div contenteditable='true' class='editable input-line' data-kt-repeater='datepicker' data-field='chk_date' data-maxlength='21'>{item("chk_date_raw")}</div>",
                    $"<div class='editable disabled' data-field='chk_date' style='pointer-events: none;'>{item("chk_date_raw")}</div>")

                    ' chk_no
                    Dim chknoHtml = If(isEditable_chk_no,
                    $"<div contenteditable='true' class='editable input-line' data-field='chk_no' data-maxlength='21'>{item("chk_no_raw")}</div>",
                    $"<div class='editable disabled' data-field='chk_no' style='pointer-events: none;'>{item("chk_no_raw")}</div>")

                    ' ewt_amt
                    Dim ewtValue As Decimal = Convert.ToDecimal(item("ewt_amt_raw"))
                    Dim ewtamtHtml = If(rowIndex = totalRows - 1 AndAlso ewtValue > 0,
                    $"<div contenteditable='true' class='editable text-end input-line' data-field='ewt_amt' data-maxlength='21'>{ewtValue.ToString("N2")}</div>",
                    $"<div class='editable disabled text-end' data-field='ewt_amt' style='pointer-events: none;'>{ewtValue.ToString("N2")}</div>")

                    ' net_amt
                    Dim netValue As Decimal = Convert.ToDecimal(item("net_amt"))
                    Dim netamtHtml = $"<div class='text-end' data-field='net_amt'>{netValue.ToString("N2")}</div>"

                    Dim discValue As Decimal = Convert.ToDecimal(item("disc_amt"))
                    Dim discamtHtml = $"<div class='text-end' data-field='disc_amt'>{discValue.ToString("N2")}</div>"

                    ' bank dropdown
                    Dim bankHtml As String = ""

                    If isEditable_bank Then
                        Dim sb As New StringBuilder()
                        sb.Append("<select class='editable form-select form-select-sm form-select-transparent rounded-start-0 ml-0 mt-2 h-10px' data-kt-repeater='select2' data-field='bank'>")
                        For Each bank In banks
                            Dim selectedAttr = If(bank("Code") = item("bankcode").ToString(), "selected", "")
                            sb.AppendFormat("<option value='{0}' {2}>{1}</option>", bank("Code"), bank("Name"), selectedAttr)
                        Next
                        sb.Append("</select>")
                        bankHtml = sb.ToString()
                    Else
                        Dim selectedBankName = banks.FirstOrDefault(Function(b) b("Code") = item("bankcode").ToString())?("Name")
                        bankHtml = $"<div class='editable disabled' data-field='bank' style='pointer-events: none;'>{selectedBankName}</div>"
                    End If

                    ' Add row
                    RecordInfo.Add(New With {
                    .pcode = item("pcode"),
                    .chk_no = chknoHtml,
                    .chk_date = chkdateHtml,
                    .chk_amt = chkamtHtml,
                    .ewt_amt = ewtamtHtml,
                    .disc_amt = item("disc_amt"),
                    .net_amt = item("net_amt"),
                    .bank = bankHtml
                })

                    rowIndex += 1
                Next
            End Using
        End Using

        ' Serialize and return
        Dim serializer As New JavaScriptSerializer()
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(RecordInfo)
    End Function
    Function newcreditorcode(creditor As String, creditor_code As String) As Object
        Dim result As New Dictionary(Of String, Object)()

        Try
            ' Ensure only valid creditor types are allowed
            Dim validCreditors As New Dictionary(Of String, String) From {
                {"Vendor", "ogm_vendor"},
                {"Agent", "agent"},
                {"Customer", "customer"},
                {"Employee", "employee"}
            }

            ' Exit early if the creditor is invalid
            If Not validCreditors.ContainsKey(creditor) Then
                result("status") = "error"
                result("message") = "Invalid creditor type."
                Return result
            End If

            Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
                ConStr.Open()

                Using Cmd2 As New SqlCommand("sys_get_rec_info", ConStr)
                    Cmd2.CommandType = CommandType.StoredProcedure

                    ' Input parameters
                    Cmd2.Parameters.AddWithValue("@tbl_name", validCreditors(creditor))
                    Cmd2.Parameters.AddWithValue("@tbl_code", creditor_code)

                    ' Output parameters
                    Cmd2.Parameters.Add("@info1", SqlDbType.NVarChar, 1000).Direction = ParameterDirection.Output
                    Cmd2.Parameters.Add("@info2", SqlDbType.NVarChar, 1000).Direction = ParameterDirection.Output
                    Cmd2.Parameters.Add("@info3", SqlDbType.NVarChar, 1000).Direction = ParameterDirection.Output
                    Cmd2.Parameters.Add("@info4", SqlDbType.NVarChar, 1000).Direction = ParameterDirection.Output
                    Cmd2.Parameters.Add("@info5", SqlDbType.NVarChar, 1000).Direction = ParameterDirection.Output

                    Cmd2.ExecuteNonQuery()

                    result("status") = "success"
                    result("info1") = Cmd2.Parameters("@info1").Value.ToString()
                    result("info2") = Cmd2.Parameters("@info2").Value.ToString()
                    result("info3") = Cmd2.Parameters("@info3").Value.ToString()
                    result("info4") = Cmd2.Parameters("@info4").Value.ToString()
                    result("info5") = Cmd2.Parameters("@info5").Value.ToString()
                End Using
            End Using

        Catch ex As Exception
            result("status") = "error"
            result("message") = ex.Message
        End Try

        Return result
    End Function
