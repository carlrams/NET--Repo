    Function Getbank()

        Dim Query As New StringBuilder
        Query.Append("select  ")
        Query.Append("	'' [Code]    ")
        Query.Append("	,'Select Bank' [Name]    ")
        Query.Append("union    ")
        Query.Append("select    ")
        Query.Append("	[A].b_code [Code]    ")
        Query.Append("	,[A].bank [Name]    ")
        Query.Append("from    ")
        Query.Append("	fin_bank [A]    ")
        Query.Append("WHERE  ")
        Query.Append("	(lock = 1) ")
        Query.Append("order by    ")
        Query.Append("	[Code] ")

        Dim ConStr As String = "Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password
        Dim SqlCon As New SqlConnection(ConStr)
        Dim SDA As New SqlDataAdapter(Query.ToString, SqlCon)
        Dim DT As New DataTable()
        SDA.Fill(DT)
        'execute query

        ' Convert DataTable to List(Of Dictionary(Of String, String))
        Dim result As New List(Of Dictionary(Of String, String))()
        For Each row As DataRow In DT.Rows
            Dim dict As New Dictionary(Of String, String)()
            dict("Code") = row("Code").ToString()
            dict("Name") = row("Name").ToString()
            result.Add(dict)
        Next

        ' Serialize the list to JSON
        Return New JavaScriptSerializer().Serialize(result)

    End Function
    Function ShowOnlinePaymentDetailsSingle(apv As String) As String
        Dim rawList As New List(Of Dictionary(Of String, Object))()

        ' Fetch the data
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand("fin_get_online_app", ConStr)
                Cmd.CommandType = CommandType.StoredProcedure
                Cmd.Parameters.AddWithValue("@tran_no", apv)

                ConStr.Open()
                Using DR As SqlDataReader = Cmd.ExecuteReader()
                    Dim index As Integer = 0
                    While DR.Read()
                        Dim row As New Dictionary(Of String, Object)

                        Dim payee = If(IsDBNull(DR("payee")), "", DR("payee").ToString())

                        row("cv_no") = If(IsDBNull(DR("cv_no")), "", DR("cv_no").ToString())
                        row("payee") = payee
                        row("remarks") = If(IsDBNull(DR("remarks")), "", DR("remarks").ToString())
                        row("net_amt") = If(IsDBNull(DR("net_amt")), "", DR("net_amt").ToString())
                        row("chk_date_val") = If(IsDBNull(DR("chk_date")), "", Convert.ToDateTime(DR("chk_date")).ToString("MM/dd/yyyy"))
                        row("chk_amt_val") = Convert.ToDecimal(DR("chk_amt")).ToString("N2")
                        row("ewt_amt_val") = If(IsDBNull(DR("ewt_amt")), "", DR("ewt_amt").ToString())
                        row("disc_amt_val") = If(IsDBNull(DR("disc_amt")), "", DR("disc_amt").ToString())
                        rawList.Add(row)
                        index += 1
                    End While
                End Using
            End Using
        End Using

        ' Group by APV block (each ends with "Total" and "actual.")
        Dim groupStartIndex As Integer = 0

        While groupStartIndex < rawList.Count
            Dim groupEndIndex As Integer = -1

            ' Find the "Total" and "actual." rows to mark end of this block
            For i = groupStartIndex To rawList.Count - 2
                If rawList(i)("cv_no").ToString().Trim().ToLower() = "total" AndAlso
               rawList(i + 1)("cv_no").ToString().Trim().ToLower().StartsWith("actual") Then
                    groupEndIndex = i + 1
                    Exit For
                End If
            Next

            If groupEndIndex = -1 Then
                groupEndIndex = rawList.Count - 1 ' Handle the final group
            End If

            ' Find payee indexes within the group
            Dim payeeIndexes As New List(Of Integer)
            For i = groupStartIndex To groupEndIndex
                Dim payee = rawList(i)("payee").ToString()
                If Not String.IsNullOrWhiteSpace(payee) Then
                    payeeIndexes.Add(i)
                End If
            Next

            Dim onlyOnePayee = (payeeIndexes.Count = 1)
            Dim firstPayeeIndex = If(payeeIndexes.Count > 0, payeeIndexes.First(), -1)
            Dim lastPayeeIndex = If(payeeIndexes.Count > 0, payeeIndexes.Last(), -1)

            ' Apply logic to rows in the group
            For i = groupStartIndex To groupEndIndex
                Dim r = rawList(i)
                Dim hasPayee = payeeIndexes.Contains(i)
                Dim isFirstPayeeRow = (i = firstPayeeIndex)
                Dim isLastPayeeRow = (i = lastPayeeIndex)

                ' chk_amt logic
                r("chk_amt") = If(hasPayee AndAlso Not onlyOnePayee,
                $"<div contenteditable='true' class='editable text-end input-line' data-field='chk_amt' data-maxlength='21'>{r("chk_amt_val")}</div>",
                $"<div class='editable text-end disabled' data-field='chk_amt' style='pointer-events: none;'>{r("chk_amt_val")}</div>")

                ' chk_date logic
                r("chk_date") = If(hasPayee AndAlso Not isFirstPayeeRow,
                $"<div contenteditable='true' class='editable input-line' data-kt-repeater='datepicker' data-field='chk_date' data-maxlength='21'>{r("chk_date_val")}</div>",
                $"<div class='editable disabled' data-field='chk_date' style='pointer-events: none;'>{r("chk_date_val")}</div>")

                ' ewt_amt and disc_amt only editable on last payee
                r("ewt_amt") = If(Not onlyOnePayee AndAlso isLastPayeeRow,
                $"<div contenteditable='true' class='editable text-end input-line' data-field='ewt_amt' data-maxlength='21'>{r("ewt_amt_val")}</div>",
                $"<div class='editable text-end disabled' data-field='ewt_amt' style='pointer-events: none;'>{r("ewt_amt_val")}</div>")

                r("disc_amt") = If(Not onlyOnePayee AndAlso isLastPayeeRow,
                $"<div contenteditable='true' class='editable text-end input-line' data-field='disc_amt' data-maxlength='21'>{r("disc_amt_val")}</div>",
                $"<div class='editable text-end disabled' data-field='disc_amt' style='pointer-events: none;'>{r("disc_amt_val")}</div>")

                ' Clean up temp values
                r.Remove("chk_amt_val")
                r.Remove("chk_date_val")
                r.Remove("ewt_amt_val")
                r.Remove("disc_amt_val")
            Next

            ' Move to next block
            groupStartIndex = groupEndIndex + 1
        End While

        ' Serialize and return
        Dim serializer As New JavaScriptSerializer()
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(rawList)
    End Function
