                Else
                    context.Response.ContentType = "application/json"
                    context.Response.Write("[]")
                End If
                'Online Payment Details

                'Generate transaction number for Online Payment
            ElseIf pFormCode = "FIN00001" And pType = "Generate-New-Transaction-Number" Then
                Dim newCode As String = ""

                Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
                    Using Cmd As New SqlCommand("sys_gen_code", ConStr)
                        Cmd.CommandType = CommandType.StoredProcedure
                        Cmd.Parameters.AddWithValue("@table", "fin_app_hdr_tran_no")
                        Cmd.Parameters.AddWithValue("@branch", "MN")

                        Dim outputParam As New SqlParameter("@Code", SqlDbType.NVarChar, 13)
                        outputParam.Direction = ParameterDirection.Output
                        Cmd.Parameters.Add(outputParam)

                        ConStr.Open()
                        Cmd.ExecuteNonQuery()

                        newCode = outputParam.Value.ToString()
                    End Using
                End Using

                ' Convert to JSON
                Dim json = New JavaScriptSerializer().Serialize(New With {
            .success = True,
            .code = newCode
        })

                context.Response.ContentType = "application/json"
                context.Response.Write(json)
                'Generate transaction number for Online Payment

                'Generate Transaction Number for Check Payment
            ElseIf pFormCode = "FIN00001" And pType = "Generate-New-Transaction-Number-Check" Then
                Dim newCode As String = ""

                Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
                    Using Cmd As New SqlCommand("sys_gen_code", ConStr)
                        Cmd.CommandType = CommandType.StoredProcedure
                        Cmd.Parameters.AddWithValue("@table", "fin_app_hdr_tran_no")
                        Cmd.Parameters.AddWithValue("@branch", "MN")

                        Dim outputParam As New SqlParameter("@Code", SqlDbType.NVarChar, 13)
                        outputParam.Direction = ParameterDirection.Output
                        Cmd.Parameters.Add(outputParam)

                        ConStr.Open()
                        Cmd.ExecuteNonQuery()

                        newCode = outputParam.Value.ToString()
                    End Using
                End Using

                ' Convert to JSON
                Dim json = New JavaScriptSerializer().Serialize(New With {
            .success = True,
            .code = newCode
        })

                context.Response.ContentType = "application/json"
                context.Response.Write(json)
                'Generate Transaction Number for Check Payment

                'Generate Online Payment Details
            ElseIf pFormCode = "FIN00001" And pType = "Generate-Online-Payment-Details" Then

                Dim serializer As New JavaScriptSerializer()

                ' Deserialize input
                Dim apvs As List(Of String) = serializer.Deserialize(Of List(Of String))(context.Request("APVs"))
                Dim checkCounts As List(Of Integer) = serializer.Deserialize(Of List(Of Integer))(context.Request("CheckCounts"))
                Dim dayIntervals As List(Of Integer) = serializer.Deserialize(Of List(Of Integer))(context.Request("DayIntervals"))
                Dim additionalTexts As List(Of String) = serializer.Deserialize(Of List(Of String))(context.Request("AdditionalTexts"))
                Dim paymentDate As String = context.Request("PaymentDateValue")
                Dim transactionCode As String = context.Request("TransactionCode") ' Now expecting just one code

                ' Validate input counts
                If Not (apvs.Count = checkCounts.Count AndAlso dayIntervals.Count = checkCounts.Count AndAlso additionalTexts.Count = checkCounts.Count) Then
                    context.Response.ContentType = "application/json"
                    context.Response.Write(serializer.Serialize(New With {
                        .success = False,
                        .message = "Input counts mismatch.",
                        .apvsCount = apvs.Count,
                        .checkCountsCount = checkCounts.Count,
                        .dayIntervalsCount = dayIntervals.Count,
                        .additionalTextsCount = additionalTexts.Count
                    }))
                    Return
                End If

                For i As Integer = 0 To apvs.Count - 1
                    Dim division23 As String = ""

                    Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)

