    Function FIN00001_LoadSendemail() As String
        Dim Query As New StringBuilder
        Query.Append("WITH MatchingCES AS (SELECT DISTINCT hdr.CESNo, LTRIM(RTRIM(SUBSTRING(hdr.APVNo, nums.n + 1,  ")
        Query.Append("	CASE WHEN CHARINDEX(',', hdr.APVNo + ',', nums.n + 1) - nums.n - 1 >= 0 THEN CHARINDEX(',', hdr.APVNo + ',', nums.n + 1) - nums.n - 1 ELSE 0 END))) AS APVCode ")
        Query.Append("    FROM calmardblive.dbo.JCF_CAHdr hdr ")
        Query.Append("    CROSS APPLY (SELECT number AS n FROM master..spt_values WHERE type = 'P' AND number < LEN(hdr.APVNo)) nums WHERE SUBSTRING(',' + hdr.APVNo, nums.n + 1, 1) = ','), ")
        Query.Append("MatchingCAC AS (SELECT DISTINCT hdr.CACode, LTRIM(RTRIM(SUBSTRING(hdr.APVNo, nums.n + 1, ")
        Query.Append("	CASE WHEN CHARINDEX(',', hdr.APVNo + ',', nums.n + 1) - nums.n - 1 >= 0 THEN CHARINDEX(',', hdr.APVNo + ',', nums.n + 1) - nums.n - 1 ELSE 0 END))) AS APVCode ")
        Query.Append("    FROM calmardblive.dbo.JCF_CAHdr hdr ")
        Query.Append("    CROSS APPLY (SELECT number AS n FROM master..spt_values WHERE type = 'P' AND number < LEN(hdr.APVNo)) nums WHERE SUBSTRING(',' + hdr.APVNo, nums.n + 1, 1) = ',') ")
        Query.Append("select * from  ")
        Query.Append(" 	(SELECT   ")
        Query.Append("    0 AS [Check],  ")
        Query.Append("    fin_apv_hdr.v_code AS [APVNo],  ")
        Query.Append("    fin_app_hdr.p_code AS [CheckCode],  ")
        Query.Append("    mstr_Sellers.SellerName AS [Name], ")
        Query.Append("    fin_app_hdr.chk_amt AS [CheckAmount],  ")
        Query.Append("    MatchingCES.CESNo,  ")
        Query.Append("    mstr_Sellers.EmailAddress AS [SellerEmail],  ")
        Query.Append("    MatchingCAC.CACode,  ")
        Query.Append("    mstr_Sellers.Cellphone AS [MobileNo] ")
        Query.Append("	FROM fin_apv_hdr ")
        Query.Append(" 		left join fin_app_hdr on fin_apv_hdr.v_code = fin_app_hdr.apv_no  ")
        Query.Append(" 		left join calmardbLive.dbo.mstr_Sellers on fin_app_hdr.crdtr_code = mstr_Sellers.AgentCode ")
        Query.Append("		LEFT JOIN MatchingCES ON MatchingCES.APVCode = fin_apv_hdr.v_code ")
        Query.Append("		LEFT JOIN MatchingCAC ON MatchingCAC.APVCode = fin_apv_hdr.v_code ")
        Query.Append(" 	where   ")
        Query.Append(" 		fin_apv_hdr.vch_type = 'Commission'  ")
        Query.Append(" 		and fin_apv_hdr.post = 1  ")
        Query.Append(" 		and fin_apv_hdr.cancel = 0  ")
        Query.Append(" 		and fin_apv_hdr.tran_no not in ('','Cancelled')  ")
        Query.Append(" 		and isnull(fin_app_hdr.CESSent,0) = 0  ")
        Query.Append(" 		and mstr_Sellers.EmailAddress not in ('')) [Tbl]  ")
        Query.Append("where  ")
        Query.Append("	[CESNo] is not null  ")
        Query.Append("order by   ")
        Query.Append("	[Name] ")





        Dim RecordInfo As New List(Of Object)()
        Dim rowIndex As Integer = 0
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.CommandTimeout = 150000
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()
                    Dim no_chk As String = "<div class='form-check form-check-sm form-check-custom form-check-solid d-flex justify-content-center align-items-center' " &
                   " style='background-color: white;'>" &
                   "<input type='checkbox' class='form-check-input checkBoxAllClass chkSelect row-checkbox px-0 mx-0' " &
                   " data-row='" & rowIndex & "'" &
                   If(DR("Check").ToString().Trim() = "1", " checked", "") & " />" &
                   "</div>"


                    RecordInfo.Add(New With {
                        .Status = no_chk,
                        .APVNo = DR("APVNo"),
