    Function FIN160000_Get_Info_Hdr(pID)

        'query
        Dim Query As New StringBuilder
        Query.Append("SELECT         ")
        Query.Append("	[A].SJCode [Code],  ")
        Query.Append("	[A].Date [Date],  ")
        Query.Append("	[A].Year [Year],  ")
        Query.Append("	[A].Period [Period],  ")
        Query.Append("	[A].RefNo [RefNo],  ")
        Query.Append("	[A].RefDate [RefDate],  ")
        Query.Append("	[A].Description [Desc],  ")
        Query.Append("	[A].Lock,  ")
        Query.Append("	[A].Post,  ")
        Query.Append("	[A].Cancel, ")
        Query.Append("	[A].CancelledRemarks ")
        Query.Append("	,(select top 1 fullname from employee where employee.emp_no  = [A].updatedby) [updated_by]  ")
        Query.Append("	,[A].UpdatedDate  ")
        Query.Append("    ,(select top 1 fullname from employee where employee.emp_no  = [A].LockedBy) [lock_by]  ")
        Query.Append("	,[A].LockedDate ")
        Query.Append("    ,(select top 1 fullname from employee where employee.emp_no  = [A].PostedBy) [post_by] ")
        Query.Append("	,[A].PostedDate  ")
        Query.Append("    ,(select top 1 fullname from employee where employee.emp_no  = [A].cancelledby) [cancel_by]  ")
        Query.Append("	,[A].CancelledDate ")
        Query.Append("	,(case when [A].cancel = 1 then 'Cancelled' when [A].post = 1 then 'Posted' when [A].lock = 0 then 'New' when [A].lock = 1 then 'Locked' when [A].lock is null then 'Unlocked' end) [RecordStatus]  ")
        Query.Append("FROM            ")
        Query.Append("	Trxn_SalesJrnl_Hdr [A] ")
        Query.Append("WHERE         ")
        Query.Append("	(SJCode = '" & pID & "') ")
        'query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {
                        .Code = DR("Code"),
                        .Lock = DR("Lock"),
                        .Post = DR("Post"),
                        .Cancel = DR("Cancel"),
                        .Date = If(IsDBNull(DR("Date")), "", Format(DR("Date"), "MM/dd/yyyy")),
                        .Period = DR("Period"),
                        .Year = DR("Year"),
                        .RefNo = DR("RefNo"),
                        .RefDate = If(IsDBNull(DR("RefDate")), "", Format(DR("RefDate"), "MM/dd/yyyy")),
                        .Desc = DR("Desc"),
                        .RecordStatus = DR("RecordStatus"),
                        .updated_by = DR("updated_by"),
                        .lock_by = DR("lock_by"),
                        .post_by = DR("post_by"),
                        .cancel_by = DR("cancel_by"),
                        .updated_date = If(IsDBNull(DR("UpdatedDate")), "", Format(DR("UpdatedDate"), "MM/dd/yyyy hh:mm tt")),
                        .lock_date = If(IsDBNull(DR("LockedDate")), "", Format(DR("LockedDate"), "MM/dd/yyyy hh:mm tt")),
                        .post_date = If(IsDBNull(DR("PostedDate")), "", Format(DR("PostedDate"), "MM/dd/yyyy hh:mm tt")),
                        .cancel_date = If(IsDBNull(DR("CancelledDate")), "", Format(DR("CancelledDate"), "MM/dd/yyyy hh:mm tt"))
                    })
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
