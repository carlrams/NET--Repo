    Function FIN140000_Upload_Excel(UploadExcel As List(Of FIN140000UploadExcel)) As String
        Dim UpdateQuery As String = "
        UPDATE fin_app_hdr
        SET chk_no = @chk_no
        WHERE p_code = @p_code
    "

        Dim RecordList As New List(Of Object)()
        Dim UpdatedCount As Integer = 0
        Dim SkippedList As New List(Of String)()

        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            ConStr.Open()
            For Each item In UploadExcel
                Using Cmd As New SqlCommand(UpdateQuery, ConStr)
                    Cmd.CommandType = CommandType.Text
                    Cmd.Parameters.AddWithValue("@chk_no", item.CheckNo)
                    Cmd.Parameters.AddWithValue("@p_code", item.CV_No)

                    Dim rowsAffected As Integer = Cmd.ExecuteNonQuery()
                    If rowsAffected > 0 Then
                        UpdatedCount += 1
                    Else
                        SkippedList.Add(item.CV_No)
                    End If
                End Using
            Next
        End Using

        RecordList.Add(New With {
            .message = "Update completed",
            .updated = UpdatedCount,
            .skipped = SkippedList
        })

        Return New JavaScriptSerializer().Serialize(RecordList)
    End Function
    Function FIN140000_Release_Account(AccountList As List(Of FIN140000AccountList), Period As String, Year As String, RcvdBy As String, DateReceived As Date) As String
