    Function FIN050000_Get_Info_Dtl(pID)

        'query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("	[A].v_code  ")
        Query.Append("	,[A].entry_date ")
        Query.Append("	,[A].vch_type ")
        Query.Append("	,(case  ")
        Query.Append("		when isnull([A].tran_no,'') = '' then '' ")
        Query.Append("		when isnull([A].tran_no,'') = 'Cancelled' then 'Cancelled' ")
        Query.Append("		else 'Processed' ")
        Query.Append("	end) [status] ")
        Query.Append("	,[A].crdtr_type ")
        Query.Append("	,(case [A].crdtr_type ")
        Query.Append("		when 'Agent' then [B].fullname ")
        Query.Append("		when 'Customer' then [C].fullname ")
        Query.Append("		when 'Employee' then [D].fullname ")
        Query.Append("		when 'Vendor' then [E].vendor ")
        Query.Append("	end) [crdtr_code_desc] ")
        Query.Append("	,[A].crdtr_code ")
        Query.Append("	,[A].reference ")
        Query.Append("	,[A].ref_date ")
        Query.Append("	,[A].description ")
        Query.Append("	,[F].description [terms_desc] ")
        Query.Append("	,[A].terms ")
        Query.Append("	,[A].base_date ")
        Query.Append("	,[A].due_date ")
        Query.Append("	,[A].due_days ")
        Query.Append("	,[A].disc_rate ")
        Query.Append("	,[A].vch_amt ")
        Query.Append("	,[A].wh_tax ")
        Query.Append("	,[A].owh_tax ")
        Query.Append("	,[A].wh_tax_amt ")
        Query.Append("	,[A].net_amt ")
        Query.Append("	,[A].vat_amt ")
        Query.Append("	,(case when [A].updated_by = 'system' then 'System' when [I].fullname IS NOT NULL then [I].fullname else ( select top 1 [G].fullname from employee [G] LEFT JOIN calmardbLive.dbo.mstr_Users [H] on [G].emp_no = [H].EmpCode where [H].logName = [A].updated_by) end) [updated_by] ")
        Query.Append("	,(select top 1 fullname from employee where employee.emp_no  = [A].lock_by) [lock_by]  ")
        Query.Append("	,[A].lock ")
        Query.Append("	,(select top 1 fullname from employee where employee.emp_no  = [A].post_by)[post_by]  ")
        Query.Append("	,[A].post ")
