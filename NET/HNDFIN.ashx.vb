    Function FIN100002_Get_DTL_Add(pID, pAcctNo)
        Dim Query As New StringBuilder
        Query.Append("select  ")
        Query.Append("	0 [Check] ")
        Query.Append("	,JCF_ChecksDtl.AcctNo + ' ' + JCF_ChecksDtl.CheckNo [Code] ")
        Query.Append("	,JCF_ChecksDtl.AcctNo ")
        Query.Append("	,CASE WHEN JCF_ChecksDtl.AcctNo = [A].AcctNo OR JCF_ChecksDtl.AcctNo = [B].Code THEN COALESCE([A].AcctName, [B].Name)ELSE [B].Name END AS [AcctName] ")
        Query.Append("	,JCF_ChecksDtl.CheckNo ")
        Query.Append("	,JCF_ChecksDtl.CheckDate ")
        Query.Append("	,JCF_ChecksDtl.CheckAmount ")
        Query.Append("	,JCF_ChecksDtl.DraweeBankCode ")
        Query.Append("	,mstr_DraweeBanks.BankDesc [DraweeBankCodeName] ")
        Query.Append("	,JCF_ChecksDtl.DepositoryBankCode ")
        Query.Append("	,mstr_DepositoryBanks.BankName [DepositoryBankCodeName] ")
        Query.Append("from ")
        Query.Append("	calmardbLive.dbo.JCF_ChecksDtl ")
        Query.Append("	left join calmardbLive.dbo.mstr_projects on JCF_ChecksDtl.projcode = mstr_projects.projcode ")
        Query.Append("	left join calmardbLive.dbo.mstr_DraweeBanks on JCF_ChecksDtl.DraweeBankCode = mstr_DraweeBanks.BankCode ")
        Query.Append("	left join calmardbLive.dbo.mstr_DepositoryBanks on JCF_ChecksDtl.DepositoryBankCode = mstr_DepositoryBanks.BankCode ")
        Query.Append("	left join calmardbLive.dbo.mstr_CheckStatus on JCF_ChecksDtl.CheckStatus = mstr_CheckStatus.CheckStatusCode ")
        Query.Append("	left join calmardbLive.dbo.mstr_PaymentType on JCF_ChecksDtl.PaymentApplication = mstr_PaymentType.PayType ")
        Query.Append("	left join calmardbLive.dbo.JCF_ChecksHdr on JCF_ChecksDtl.TrxnNo = JCF_ChecksHdr.TrxnNo ")
        Query.Append("	left join calmardbLive.dbo.ICR_Buyers [A] on JCF_ChecksDtl.AcctNo = [A].AcctNo  ")
        Query.Append("	left join calmardbLive.dbo.JCF_LotConnection [B] on JCF_ChecksDtl.AcctNo = [B].Code  ")
        Query.Append("where ")
        Query.Append("	JCF_ChecksHdr.Post = 1 ")
        Query.Append("	and JCF_ChecksHdr.Rvrs = 0 ")
