                ConStr.Open()
                ' First stored procedure: fin_upd_app_hdr
                Using Cmd1 As New SqlCommand("fin_upd_app_hdr", ConStr)
                    Cmd1.CommandType = CommandType.StoredProcedure

                    Cmd1.Parameters.AddWithValue("@p_code", p_code)
