    Function FIN00001_Sendemail(emaillist As List(Of EmailSellerCesnoData)) As String
        Dim result As String = "Success"
        Dim sentCount As Integer = 0

        Try
            Dim smtp As New SmtpClient("mail.calmarland.com")
            smtp.Credentials = New NetworkCredential("ciissystems@calmarland.com", "M5ilp5ssw0rd")
            smtp.Port = 587
            smtp.EnableSsl = False ' Set to True if required by your mail server

            For Each item In emaillist

                Dim email As String = If(String.IsNullOrWhiteSpace(item.Email), "", item.Email.Trim())
                Dim seller As String = If(String.IsNullOrWhiteSpace(item.Seller), "", item.Seller.Trim())
                Dim CESNo As String = If(String.IsNullOrWhiteSpace(item.CESNo), "", item.CESNo.Trim())

                If Not String.IsNullOrWhiteSpace(email) AndAlso Not String.IsNullOrWhiteSpace(seller) Then
                    Dim content As New StringBuilder()
                    content.Append("<html><body>")
                    content.Append("Dear <b>" & seller & "</b>,<br /><br />")
                    content.Append("Hello! We are delighted to inform you that your sales commissions for the following accounts have been released today.<br />")
                    content.Append("We sincerely appreciate your hard work and dedication.<br /><br />")
                    content.Append("Attached in the email are the copies of CES.<br /><br />")
                    content.Append("Thank you and have a great day.<br /><br />")
                    content.Append("</body></html>")

                    Dim mail As New MailMessage()
                    mail.From = New MailAddress("ciissystems@calmarland.com")
                    mail.To.Add(email)
                    mail.Subject = "Commission Notice - " & seller
                    mail.Body = content.ToString()
                    mail.IsBodyHtml = True

                    ' Attachment
                    Dim filePath As String = "C:\ciis_temp\Treasury\" & seller & " - " & CESNo & " - " & Format(Date.Now, "MM-dd-yyyy") & ".pdf"
                    If File.Exists(filePath) Then
                        mail.Attachments.Add(New Attachment(filePath))
