        Query.Append("  ,isnull([A].lock, 0) [Lock] ")
        Query.Append("from ")
        Query.Append("  sys_um [A] ")
        Query.Append("order by ")
        Query.Append("  [A].abbr ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    Dim Action As New StringBuilder
                    Action.Append("<div class='action-toggle-wrapper' style='position: relative; display: inline-block;'>")
                    Action.Append("      <button class='btn btn-sm btn-icon btn-view' title='Edit' onclick=""fn010103Add('" & DR("Code") & "', '" & DR("Lock") & "');return false;""><i class='las la-check fs-3'></i></button>")
                    Action.Append("</div>")

                    RecordList.Add(New With {
                        .rowId = "rowID010103" & DR("Code"),
                        .Action = Action.ToString,
                        .Lock = "<div class='form-check form-check-custom form-check-solid form-check-success w-100 flex-center'><input class='form-check-input' type='checkbox' value='' " & IIf(DR("Lock") = 1, " checked='checked'", "") & " onclick='return false'/></div>",
                        .Code = DR("Code"),
                        .Description = DR("Description")
                    })

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return JsonConvert.SerializeObject(RecordList, Formatting.None)
        'display

    End Function
    Function FIN170100_Add_Rvrs_Record_Material(pID, pCategory, pCENo, pWCode, pTblCode, pParticular, pCost, pUOMCode, pQty, pTotal, pRemarks, pEstimate, pRequest, pCreatedBy, pUpdatedBy)

        'add query
        Dim Query As New StringBuilder
        Query.Append("declare @pID nvarchar(13) = '" & pID & "' ")
        Query.Append("declare @pSeqNo int = (isnull((select MAX(SeqNo) from Trxn_CERvsn where CECode = @pID),0) + 1) ")
        Query.Append("INSERT INTO Trxn_CERvsn ")
        Query.Append("  (CECode ")
        Query.Append("  ,SeqNo ")
        Query.Append("  ,Type ")
        Query.Append("  ,ItemNo ")
        Query.Append("  ,WCode ")
        Query.Append("  ,Tagged ")
        Query.Append("  ,TblFrom ")
        Query.Append("  ,TblCode ")
        Query.Append("  ,Particular ")
        Query.Append("  ,Cost ")
        Query.Append("  ,UMCode ")
        Query.Append("  ,Qty ")
        Query.Append("  ,Total ")
        Query.Append("  ,Remarks ")
        Query.Append("  ,CreatedBy ")
        Query.Append("  ,CreatedDate ")
        Query.Append("  ,UpdatedBy ")
        Query.Append("  ,UpdatedDate) ")
        Query.Append("VALUES ")
        Query.Append("  (@pID ")
        Query.Append("  ,@pSeqNo ")
        Query.Append("  ,'" & IIf(pEstimate = True, "Estimate", IIf(pRequest = True, "Request", Nothing)) & "' ")
        Query.Append("  ,'" & FIN170100_Get_WBSCode(pCategory, pCENo, pID, pWCode).ToString & "' ")
        Query.Append("  ,'" & pWCode & "' ")
        Query.Append("  ,(select (case when '" & pParticular & "' in (select item from ogm_item where item = '" & pParticular & "' and i_code = '" & pTblCode & "') then 1 else 0 end)) ")
        Query.Append("  ,'ogm_item' ")
        Query.Append("  ,'" & pTblCode & "' ")
        Query.Append("  ,'" & pParticular & "' ")
        Query.Append("  ," & CDbl(pCost) & " ")
        Query.Append("  ,'" & pUOMCode & "' ")
        Query.Append("  ," & CDbl(pQty) & " ")
        Query.Append("  ," & CDbl(pTotal) & " ")
        Query.Append("  ,'" & pRemarks & "' ")
        Query.Append("  ,'" & pCreatedBy & "' ")
        Query.Append("  ,GETDATE() ")
        Query.Append("  ,'" & pUpdatedBy & "' ")
        Query.Append("  ,GETDATE()) ")
        Query.Append("select @pID [oID], @pSeqNo [oSeqNo] ")
        'add query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.oID = DR("oID"), .oSeqNo = DR("oSeqNo")})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
    Function FIN170100_Preview_RDLC(pReport As String, pBatch As String, pType As String, context As HttpContext)

        If pReport = "Cost Estimate - Detail" Then

            Dim result As New Dictionary(Of String, String)

            Try
                ' Define paths
                Dim FolderPath = context.Server.MapPath("~/Assets/RDLC/" & CIIS_EmpCode & "/")

                ' Create report folder if it doesn't exist
                If Not Directory.Exists(FolderPath) Then
                    Directory.CreateDirectory(FolderPath)
                End If

                ' Delete existing files in the report folder
                Dim reportDir As New DirectoryInfo(FolderPath)
                For Each file In reportDir.GetFiles()
                    file.Delete()
                Next

                ' Copy template report
                File.Copy(context.Server.MapPath("~/Assets/RDLC/SCMRT0023.rdlc"), Path.Combine(FolderPath, "SCMRT0023.rdlc"), True)

                result("status") = "success"
                result("viewUrl") = "SCMRTView?pFormCode=SCMRT0023&pBatch=" & pBatch & "&pType=" & pType

            Catch ex As Exception
                result("status") = "error"
                result("message") = ex.Message
            End Try

            Return New JavaScriptSerializer().Serialize(result)

        End If

        If pReport = "Cost Estimate - Summary" Then

            Dim result As New Dictionary(Of String, String)

            Try
                ' Define paths
                Dim FolderPath = context.Server.MapPath("~/Assets/RDLC/" & CIIS_EmpCode & "/")

                ' Create report folder if it doesn't exist
                If Not Directory.Exists(FolderPath) Then
                    Directory.CreateDirectory(FolderPath)
                End If

                ' Delete existing files in the report folder
                Dim reportDir As New DirectoryInfo(FolderPath)
                For Each file In reportDir.GetFiles()
                    file.Delete()
                Next

                ' Copy template report
                File.Copy(context.Server.MapPath("~/Assets/RDLC/SCMRT0024.rdlc"), Path.Combine(FolderPath, "SCMRT0024.rdlc"), True)

                result("status") = "success"
                result("viewUrl") = "SCMRTView?pFormCode=SCMRT0024&pBatch=" & pBatch & "&pType=" & pType

            Catch ex As Exception
                result("status") = "error"
                result("message") = ex.Message
            End Try

            Return New JavaScriptSerializer().Serialize(result)

        End If

    End Function
    Function FIN1701000_Cancel_Record(pID, pReason, pReversedBy)

        'variable
