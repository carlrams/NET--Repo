                                                "<span style='display:none;'>" & post & "</span>" & ' Hidden numeric value
                                                "</div>"



                        Dim reversed As String = "<div class='form-check form-check-sm form-check-custom form-check-solid' " &
                                                "style='background-color: white; padding-right: 3px; margin-right: 3px; align-content: center'>" &
                                                "<input id='chkSelect' runat='server' class='form-check-input checkBoxAllClass chkSelect' " &
                                                "type='checkbox' " & If(rev = "1", "checked='1'", "0") & " style='pointer-events: none;' />" &
                                                "<span style='display:none;'>" & rev & "</span>" & ' Hidden numeric value
                                                "</div>"

