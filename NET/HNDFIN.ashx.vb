    Function FIN150000_GetCVNo(UploadExcel As List(Of FIN150000UploadExcel)) As String
        Dim resultList As New List(Of Object)()

        Dim SelectQuery As String = "
        SELECT TOP 1 p_code 
        FROM fin_app_hdr 
        WHERE chk_no = @chkno 
          AND chk_amt - ISNULL(ewt_amt, 0) = @chkamt 
          AND ISNULL(Unclrd, 0) = 0 
          AND ISNULL(Rls, 0) = 1
    "

        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            ConStr.Open()

            For Each item In UploadExcel
                Using Cmd As New SqlCommand(SelectQuery, ConStr)
                    Cmd.Parameters.Add("@chkno", SqlDbType.NVarChar).Value = item.chk_no
                    Cmd.Parameters.Add("@chkamt", SqlDbType.Decimal).Value = Convert.ToDecimal(item.chk_amt)

                    Dim result = Cmd.ExecuteScalar()
                    If result IsNot Nothing Then
                        resultList.Add(New With {
                        .cv_no = result.ToString(),
                        .chk_no = item.chk_no,
                        .chk_amt = item.chk_amt
                    })
                    End If
                End Using
            Next
        End Using

        Return New JavaScriptSerializer().Serialize(resultList)
    End Function

