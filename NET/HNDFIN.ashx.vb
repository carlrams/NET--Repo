                        RecordList.Add(New With {
                          .ID = ID,
                          .lock = locked,
                          .post = postrem,
                          .cancel = reversed,
                          .jrnl = If(IsDBNull(DR("journal")), "", DR("journal").ToString()),
                          .year = If(IsDBNull(DR("year")), "", DR("year").ToString()),
                          .period = If(IsDBNull(DR("period")), "", DR("period").ToString()),
                          .jrnldate = formattedDate,
                          .refdesc = referencedesc,
                          .jrnldesc = jdesc,
                          .prepby = prepared_by
                        })
                    End While
                    DR.Close()
                    ConStr.Close()
                End Using
            End Using
        End Using
        'Display
        Dim serializer As New JavaScriptSerializer()
        serializer.MaxJsonLength = Integer.MaxValue
        Return serializer.Serialize(RecordList)
        'Display
