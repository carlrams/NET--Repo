        Query.Append("	,fin_app_hdr.chk_no ")
        Query.Append("	,fin_app_hdr.chk_date ")
        Query.Append("	,isnull(fin_app_hdr.chk_amt ,0) - isnull(fin_app_hdr.ewt_amt ,0) [chk_amt]		 ")
        Query.Append("from  ")
        Query.Append("	fin_app_hdr  ")
        Query.Append("	left join fin_bank on fin_app_hdr.bank = fin_bank.b_code ")
        Query.Append("	left join agent on fin_app_hdr.crdtr_type = 'Agent' and fin_app_hdr.crdtr_code = agent.agent_code ")
        Query.Append("	left join customer on fin_app_hdr.crdtr_type = 'Customer' and fin_app_hdr.crdtr_code = customer.cust_code ")
        Query.Append("	left join employee on fin_app_hdr.crdtr_type = 'Employee' and fin_app_hdr.crdtr_code = employee.emp_no ")
        Query.Append("	left join ogm_vendor on fin_app_hdr.crdtr_type = 'Vendor' and fin_app_hdr.crdtr_code = ogm_vendor.v_code ")
        Query.Append("where  ")
        Query.Append("	fin_app_hdr.post = 1  ")
        Query.Append("	and isnull(fin_app_hdr.cancel,0) = 0 ")
        Query.Append("	and isnull(fin_app_hdr.Unclrd,0) = 1 ")
        Query.Append("	and cast(fin_app_hdr.post_date as date) >= '2025-03-07' ")
        'query

        'variable
        Dim RecordList As New List(Of Object)()
        Dim rowIndex As Integer = 0
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()


                    RecordList.Add(New With {
                        .p_code = "<span title='" & DR("p_code") & "'>" & DR("p_code") & "</span>",
                        .crdtr_type = "<span title='" & DR("crdtr_type") & "'>" & DR("crdtr_type") & "</span>",
                        .Payee = "<span title='" & DR("Payee") & "'>" & DR("Payee") & "</span>",
                        .bank = "<span title='" & DR("bank") & "'>" & DR("bank") & "</span>",
                        .chk_no = "<span title='" & DR("chk_no") & "'>" & DR("chk_no") & "</span>",
                        .chk_date = Convert.ToDateTime(DR("chk_date")).ToString("MM/dd/yyyy"),
                        .chk_amt = DR("chk_amt")
                    })
                    rowIndex += 1
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

