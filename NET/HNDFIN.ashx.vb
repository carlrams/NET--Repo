        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            ConStr.Open()

            For Each item In AccountList
                Using sqlCmd As New SqlCommand("Post_ForReleaseCheck", ConStr)
                    sqlCmd.CommandTimeout = 180
                    sqlCmd.CommandType = CommandType.StoredProcedure

                    sqlCmd.Parameters.AddWithValue("@pYear", Year)
                    sqlCmd.Parameters.AddWithValue("@pPeriod", Period)
                    sqlCmd.Parameters.AddWithValue("@ReceivedBy", RcvdBy)
                    sqlCmd.Parameters.AddWithValue("@ReceivedDate", DateReceived)
                    sqlCmd.Parameters.AddWithValue("@pCVSrs", item.code)
                    sqlCmd.Parameters.AddWithValue("@pReleaseBy", CIIS_EmpCode)

                    Try
                        sqlCmd.ExecuteNonQuery()
                    Catch ex As Exception
                        ' Optionally log or handle errors here
                    End Try
                End Using
            Next
        End Using

        RecordList.Add(New With {
            .message = "Update completed"
        })

        Return New JavaScriptSerializer().Serialize(RecordList)
    End Function


