    Function GetBranch()

        Dim Query As New StringBuilder
        Query.Append("select  ")
        Query.Append("	'' [Code]    ")
        Query.Append("	,'Select Branch' [Name]    ")
        Query.Append("union    ")
        Query.Append("select    ")
        Query.Append("	[A].buss_code [Code]    ")
        Query.Append("	,[A].description [Name]    ")
        Query.Append("from    ")
        Query.Append("	business [A] ")
        Query.Append("WHERE  ")
        Query.Append("	(lock = 1) ")
        Query.Append("order by    ")
        Query.Append("	[Code] ")

        Dim ConStr As String = "Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password
        Dim SqlCon As New SqlConnection(ConStr)
        Dim SDA As New SqlDataAdapter(Query.ToString, SqlCon)
        Dim DT As New DataTable()
        SDA.Fill(DT)
        'execute query

        ' Convert DataTable to List(Of Dictionary(Of String, String))
        Dim result As New List(Of Dictionary(Of String, String))()
        For Each row As DataRow In DT.Rows
            Dim dict As New Dictionary(Of String, String)()
            dict("Code") = row("Code").ToString()
            dict("Name") = row("Name").ToString()
            result.Add(dict)
        Next

        ' Serialize the list to JSON
        Return New JavaScriptSerializer().Serialize(result)

    End Function
