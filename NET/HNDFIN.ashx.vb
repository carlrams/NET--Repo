    Function FIN100000_Generate_PDCADA_CBSDeposit(pCheckList As List(Of FIN100000CheckList), context As HttpContext) As String

        Dim result As New Dictionary(Of String, String)

        Try
            ' Define paths
            Dim reportFolderPath = context.Server.MapPath("~/Assets/Report/" & CIIS_EmpCode & "/")
            Dim pdfFolderPath = context.Server.MapPath("~/Assets/PDF/" & CIIS_EmpCode & "/")

            ' Create report folder if it doesn't exist
            If Not Directory.Exists(reportFolderPath) Then
                Directory.CreateDirectory(reportFolderPath)
            End If

            ' Delete existing files in the report folder
            Dim reportDir As New DirectoryInfo(reportFolderPath)
            For Each file In reportDir.GetFiles()
                file.Delete()
            Next

            ' Create PDF folder if it doesn't exist
            If Not Directory.Exists(pdfFolderPath) Then
                Directory.CreateDirectory(pdfFolderPath)
            End If

            ' Delete existing files in the PDF folder
            Dim pdfDir As New DirectoryInfo(pdfFolderPath)
            For Each file In pdfDir.GetFiles()
                file.Delete()
            Next

            ' Copy template report
            File.Copy(context.Server.MapPath("~/Assets/Report/FIN10RPT04.rpt"), Path.Combine(reportFolderPath, "FIN10RPT04.rpt"), True)

            ' Load and configure report
            Dim RptDoc As New ReportDocument()
            RptDoc.Load(Path.Combine(reportFolderPath, "FIN10RPT04.rpt"))

            Dim logoninfo As TableLogOnInfo
            For Each tbcurrent As Table In RptDoc.Database.Tables
                logoninfo = tbcurrent.LogOnInfo()
                logoninfo.ConnectionInfo.ServerName = DataSource
                logoninfo.ConnectionInfo.DatabaseName = catalog
                logoninfo.ConnectionInfo.UserID = UserID
                logoninfo.ConnectionInfo.Password = Password
                tbcurrent.ApplyLogOnInfo(logoninfo)
            Next

            RptDoc.SetDatabaseLogon(UserID, Password, DataSource, catalog)
            Dim Cntr As Integer = 1
            For Each item In pCheckList
                If Cntr > 8 Then Exit For

                RptDoc.SetParameterValue("bank" & Cntr, "CBS")
                RptDoc.SetParameterValue("check" & Cntr, item.CheckNo)
                RptDoc.SetParameterValue("amt" & Cntr, item.CheckAmount)

                Cntr += 1
            Next

            While Cntr <= 8
                RptDoc.SetParameterValue("bank" & Cntr, "")
                RptDoc.SetParameterValue("check" & Cntr, "")
                RptDoc.SetParameterValue("amt" & Cntr, 0)
                Cntr += 1
            End While

            ' Export to PDF
            Dim stream As Stream = RptDoc.ExportToStream(ExportFormatType.PortableDocFormat)
            Dim buf(CInt(stream.Length - 1)) As Byte
            stream.Read(buf, 0, buf.Length)
            File.WriteAllBytes(Path.Combine(pdfFolderPath, "FIN10RPT04.pdf"), buf)

            ' Cleanup
            RptDoc.Close()
            RptDoc.Dispose()

            ' Encrypt path and return response
            Dim encryptedPath As String = EncryptionHelper.EncryptString("~/Assets/PDF/" & CIIS_EmpCode & "/FIN10RPT04.pdf")
            result("status") = "success"
            result("viewUrl") = "MNU020200?View=" & encryptedPath

        Catch ex As Exception
            result("status") = "error"
            result("message") = ex.Message
        End Try

        Return New JavaScriptSerializer().Serialize(result)

    End Function

    Function FIN100000_Generate_PDCADA_CBSDepositExcel(pCheckList As List(Of FIN100000CheckList), context As HttpContext) As String

        Dim result As New Dictionary(Of String, String)

        Try
            ' Define paths
            Dim reportFolderPath = context.Server.MapPath("~/Assets/Report/" & CIIS_EmpCode & "/")
            Dim pdfFolderPath = context.Server.MapPath("~/Assets/PDF/" & CIIS_EmpCode & "/")

            If Not Directory.Exists(reportFolderPath) Then Directory.CreateDirectory(reportFolderPath)
            If Not Directory.Exists(pdfFolderPath) Then Directory.CreateDirectory(pdfFolderPath)

            For Each file In New DirectoryInfo(reportFolderPath).GetFiles() : file.Delete() : Next
            For Each file In New DirectoryInfo(pdfFolderPath).GetFiles() : file.Delete() : Next

            ' Copy rpt template
            File.Copy(context.Server.MapPath("~/Assets/Report/FIN10RPT04.rpt"), Path.Combine(reportFolderPath, "FIN10RPT04.rpt"), True)

            Dim RptDoc As New ReportDocument()
            RptDoc.Load(Path.Combine(reportFolderPath, "FIN10RPT04.rpt"))

            ' Apply DB login
            Dim logoninfo As TableLogOnInfo
            For Each tbcurrent As Table In RptDoc.Database.Tables
                logoninfo = tbcurrent.LogOnInfo()
                logoninfo.ConnectionInfo.ServerName = DataSource
                logoninfo.ConnectionInfo.DatabaseName = catalog
                logoninfo.ConnectionInfo.UserID = UserID
                logoninfo.ConnectionInfo.Password = Password
                tbcurrent.ApplyLogOnInfo(logoninfo)
            Next

            RptDoc.SetDatabaseLogon(UserID, Password, DataSource, catalog)

            ' Parameters
            Dim Cntr As Integer = 1
            For Each item In pCheckList
                If Cntr > 8 Then Exit For
                RptDoc.SetParameterValue("bank" & Cntr, "CBS")
                RptDoc.SetParameterValue("check" & Cntr, item.CheckNo)
                RptDoc.SetParameterValue("amt" & Cntr, item.CheckAmount)
                Cntr += 1
            Next
            While Cntr <= 8
                RptDoc.SetParameterValue("bank" & Cntr, "")
                RptDoc.SetParameterValue("check" & Cntr, "")
                RptDoc.SetParameterValue("amt" & Cntr, 0)
                Cntr += 1
            End While

            ' --- Export PDF ---
            Dim pdfPath As String = Path.Combine(pdfFolderPath, "FIN10RPT04.pdf")
            RptDoc.ExportToDisk(ExportFormatType.PortableDocFormat, pdfPath)

            ' --- Export Excel (with layout options) ---
            Dim excelPath As String = Path.Combine(pdfFolderPath, "FIN10RPT04.xls") ' XLS works best
            Dim exportOpts As ExportOptions = RptDoc.ExportOptions
            Dim excelOpts As New ExcelFormatOptions() With {
            .ExcelUseConstantColumnWidth = False,
            .ExcelTabHasColumnHeadings = True,
            .ShowGridLines = False
        }
            exportOpts.ExportFormatType = ExportFormatType.Excel
            exportOpts.ExportFormatOptions = excelOpts
            exportOpts.ExportDestinationType = ExportDestinationType.DiskFile
            exportOpts.ExportDestinationOptions = New DiskFileDestinationOptions() With {
            .DiskFileName = excelPath
        }
            RptDoc.Export()

            ' Cleanup
            RptDoc.Close()
            RptDoc.Dispose()

            Dim pdfVirtualPath As String = "~/Assets/PDF/" & CIIS_EmpCode & "/FIN10RPT04.pdf"
            Dim excelVirtualPath As String = "~/Assets/PDF/" & CIIS_EmpCode & "/FIN10RPT04.xls"

            If String.IsNullOrEmpty(CIIS_EmpCode) Then
                Throw New Exception("CIIS_EmpCode is not set.")
            End If

            If Not File.Exists(context.Server.MapPath(pdfVirtualPath)) Then
                Throw New Exception("PDF file not generated.")
            End If

            If Not File.Exists(context.Server.MapPath(excelVirtualPath)) Then
                Throw New Exception("Excel file not generated.")
            End If

            Dim encryptedPdfPath As String = EncryptionHelper.EncryptString(pdfVirtualPath)
            Dim encryptedExcelPath As String = EncryptionHelper.EncryptString(excelVirtualPath)

            result("status") = "success"
            result("viewPdfUrl") = "MNU020200?View=" & encryptedPdfPath
            result("downloadExcelUrl") = "MNU020200?Download=" & encryptedExcelPath

        Catch ex As Exception
            result("status") = "error"
            result("message") = ex.Message
        End Try

        Return New JavaScriptSerializer().Serialize(result)

    End Function

