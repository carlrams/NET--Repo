        SqlCmd.Parameters.AddWithValue("@pRvrsBy", pReversedBy)
        'create connection

        'execute procedure
        SqlConn.Open()
        SqlCmd.ExecuteNonQuery()
        SqlConn.Close()
        'execute procedure

        'add value
