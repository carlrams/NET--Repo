    Function FIN100000_Get_NextTrxnNo()
        'query
        Dim Query As New StringBuilder
        Query.Append("SELECT ")
        Query.Append("    CASE  ")
        Query.Append("        WHEN MAX(TrxnNo) IS NULL  ")
        Query.Append("            THEN CAST(YEAR(GETDATE()) AS varchar(4)) + '000000' ")
        Query.Append("        WHEN YEAR(GETDATE()) > CAST(LEFT(MAX(TrxnNo), 4) AS int) ")
        Query.Append("            THEN CAST(YEAR(GETDATE()) AS varchar(4)) + '000000' ")
        Query.Append("        ELSE CAST(CAST(MAX(TrxnNo) AS int) + 1 AS varchar(20)) ")
