#Region "FIN010000"

    Function FIN010000_Counter()

        'get total task
        Dim Query As New StringBuilder
        Query.Append("select")
        Query.Append("   isnull((select Count(1) from Form_HWTask [A] left join Form_HWHdr [B] on [A].HWCode = [B].HWCode where [A].TaskCode = '006' and [B].ConStatus = 'Awarded' and [B].ConPrice > isnull([B].BillAmt,0) and [A].AssignTo = '" & CIIS_EmpCode & "'),0) ")
        Query.Append("   + isnull((select Count(1) from Form_CRT [A] left join oop_form_hdr [B] on [A].CRTCode = [B].tbl_Code where [B].tbl_from = 'Form_CRT' and [B].status not in ('Cancelled','Declined') and [A].ContractStatus = 'Awarded' and [A].ContractPrice > isnull([A].BillAmt,0) and [B].approver = '" & CIIS_EmpCode & "'),0) [Total] ")
        'get total task

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()
                    RecordList.Add(New With {
                        .Total = DR("Total")
                    })
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display 

    End Function

    Function FIN010000_Filter(pArchive, pID, pAssignTo, pCategory, pSubd, pPhase, pBlock, pLot, pBatch, pContractor, pRetention)

        'get query 
        Dim Query As New StringBuilder
        If pArchive = True Then
            Query.Append("select  ")
            Query.Append("   [A].HWCode [ID] ")
            Query.Append("   ,[B].BatchNo + ' / ' + [C].ProjInit + ' ' + [B].Phase + ' B' + [B].Block + ' L' + [B].Lot + ' / ' + [D].ModelName [Title] ")
            Query.Append("   ,[E].vendor [Contractor] ")
            Query.Append("   ,[B].ConNo [ConNo] ")
            Query.Append("   ,FORMAT([B].ConPrice,'N2') [Price] ")
            Query.Append("   ,FORMAT([B].BillAmt,'N2') [Billed] ")
            Query.Append("   ,FORMAT([B].TCPBal,'N2') [Balance] ")
            Query.Append("   ,[A].AssignTo [AssignToCode] ")
            Query.Append("   ,dbo.ProperCase([F].first_name) [AssignToName] ")
            Query.Append("from ")
            Query.Append("   Form_HWTask [A] ")
            Query.Append("   left join Form_HWHdr [B] on [A].HWCode = [B].HWCode ")
            Query.Append("   left join calmardblive.dbo.mstr_Projects [C] on [B].Subd = [C].ProjCode ")
            Query.Append("   left join calmardblive.dbo.mstr_HouseModels [D] on [B].House = [D].ModelCode")
            Query.Append("   left join ogm_vendor [E] on [B].Contractor = [E].v_code ")
            Query.Append("   left join employee [F] on [A].AssignTo = [F].emp_no ")
            Query.Append("where ")
            Query.Append("   [A].TaskCode = '006' ")
            Query.Append("   and [B].ConStatus = 'Awarded'")
            Query.Append("   and [B].ConPrice <= isnull([B].BillAmt,0) ")

            'filter
            If pID <> "" Then Query.Append("   and [A].HWCode = '" & pID & "' ")
            If pAssignTo <> "" Then Query.Append("   and [A].AssignTo = '" & pAssignTo & "' ")
            If pCategory <> "" Then Query.Append("   and [A].TaskName = '" & pCategory & "' ")
            If pSubd <> "" Then Query.Append("   and [C].ProjInit like '%" & pSubd & "%' ")
            If pPhase <> "" Then Query.Append("   and [C].ProjInit + ' ' + [B].Phase like '%" & pSubd & " " & pPhase & "%' ")
            If pBlock <> "" Then Query.Append("   and [C].ProjInit + ' ' + [B].Phase + ' ' + [B].Block like '%" & pSubd & " " & pPhase & " " & pBlock & "%' ")
            If pLot <> "" Then Query.Append("   and [C].ProjInit + ' ' + [B].Phase + ' ' + [B].Block + ' ' + [B].Lot like '%" & pSubd & " " & pPhase & " " & pBlock & " " & pLot & "%' ")
            If pBatch <> "" Then Query.Append("   and [B].BatchNo = '" & pBatch & "' ")
            If pContractor <> "" Then Query.Append("   and [B].Contractor = '" & pContractor & "' ")
            If pRetention = True Then Query.Append("   and [B].RFBal > 0 ")
            'filter

            Query.Append("union  ")
            Query.Append("select  ")
            Query.Append("   [A].f_code [ID] ")
            Query.Append("   ,[A].FormTitle [Title] ")
            Query.Append("   ,[C].vendor [Contractor] ")
            Query.Append("   ,[B].ContractNo [ConNo] ")
            Query.Append("   ,FORMAT([B].ContractPrice,'N2') [Price] ")
            Query.Append("   ,FORMAT([B].BillAmt,'N2') [Billed] ")
            Query.Append("   ,FORMAT([B].TCPBal,'N2') [Balance] ")
            Query.Append("   ,[A].approver [AssignToCode] ")
            Query.Append("   ,dbo.ProperCase([D].first_name) [AssignToName] ")
            Query.Append("from ")
            Query.Append("   oop_form_hdr [A] ")
            Query.Append("   left join Form_CRT [B] on [A].tbl_code = [B].CRTCode ")
            Query.Append("   left join ogm_vendor [C] on [B].Contractor = [C].v_code ")
            Query.Append("   left join employee [D] on [A].approver = [D].emp_no ")
            Query.Append("where ")
            Query.Append("   [A].status not in ('Cancelled','Declined')")
            Query.Append("   and [A].tbl_from = 'Form_CRT' ")
