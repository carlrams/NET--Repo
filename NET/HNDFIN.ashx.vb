    Function FIN150000_Edit_branch(branchlist As List(Of FIN150000NewBranch)) As String
        Dim UpdateQuery As String = "
        UPDATE       
            fin_app_hdr
        SET                
            branch = @branch,
            RlsUpdatedBy = @UpdateBy,
            RlsUpdatedDate = GETDATE()
        WHERE  
            (p_code = @p_code)
    "

        Dim RecordList As New List(Of Object)()

        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
