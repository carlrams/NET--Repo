    <!--begin::manual sidebar-->
    <style>
        #kt_sidebar_body .nav-item a,
        #kt_interface_body .nav-item a,
        #kt_video_tutorials .nav-item a,
        #kt_version_comparison .nav-item a {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #000; /* Default text color */
            padding: 0.5rem 0.75rem;
            position: relative;
            transition: background-color 0.3s, color 0.3s;
        }

            /* Bullet default state */
            #kt_sidebar_body .nav-item a .bullet,
            #kt_interface_body .nav-item a .bullet,
            #kt_video_tutorials .nav-item a .bullet,
            #kt_version_comparison .nav-item a .bullet {
                opacity: 0;
                visibility: hidden;
                transform: scale(0.8); /* Shrink for smooth effect */
                transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
            }

            /* Active state */
            #kt_sidebar_body .nav-item a.active,
            #kt_interface_body .nav-item a.active,
            #kt_video_tutorials .nav-item a.active,
            #kt_version_comparison .nav-item a.active {
                background-color: #e0e0e0; /* Highlighted background */
                color: #007bff; /* Highlighted text color */
            }

                /* Show bullet when active */
                #kt_sidebar_body .nav-item a.active .bullet,
                #kt_interface_body .nav-item a.active .bullet,
                #kt_video_tutorials .nav-item a.active .bullet,
                #kt_version_comparison .nav-item a.active .bullet {
                    opacity: 1;
                    visibility: visible;
                    transform: scale(1); /* Return to normal size */
                }

            /* Hover styles (overrides active styles) */
            #kt_sidebar_body .nav-item a:hover,
            #kt_interface_body .nav-item a:hover,
            #kt_video_tutorials .nav-item a:hover,
            #kt_version_comparison .nav-item a:hover {
                background-color: #f0f0f0; /* Optional hover background */
                color: #0056b3; /* Optional hover text color */
            }

                /* Show bullet on hover */
                #kt_sidebar_body .nav-item a:hover .bullet,
                #kt_interface_body .nav-item a:hover .bullet,
                #kt_video_tutorials .nav-item a:hover .bullet,
                #kt_version_comparison .nav-item a:hover .bullet {
                    opacity: 1;
                    visibility: visible;
                    transform: scale(1); /* Ensure bullet is shown */
                }

        /* Font style for intro js */
        .customTooltip * {
            font-family: 'Poppins', sans-serif !important;
        }

        .customTooltip .introjs-tooltip-title {
            font-family: 'Poppins', sans-serif !important;
        }

        /* Apply Poppins font to all Intro.js buttons */
        .introjs-button {
            font-family: 'Poppins', sans-serif !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            padding: 6px 12px !important;
            border-radius: 5px !important;
            transition: all 0.3s ease-in-out !important;
            text-shadow: none !important; /* Fixes the "thick text" issue */
        }

        /* Style the Previous button */
        .introjs-prevbutton {
            background-color: white !important;
            color: #dc3545 !important; /* Bootstrap danger red */
            border: 1px solid #dc3545 !important;
            font-weight: 500 !important; /* Ensure text stays consistent */
        }

            /* Hover effect for Previous button */
            .introjs-prevbutton:hover {
                background-color: #dc3545 !important;
                color: white !important;
                font-weight: 500 !important;
                text-shadow: none !important; /* Prevents extra thickness */
            }

        /* Style the Next button */
        .introjs-nextbutton {
            background-color: white !important;
            color: #28a745 !important; /* Bootstrap success green */
            border: 1px solid #28a745 !important;
            font-weight: 500 !important;
        }

            /* Hover effect for Next button */
            .introjs-nextbutton:hover {
                background-color: #28a745 !important;
                color: white !important;
                font-weight: 500 !important;
                text-shadow: none !important;
            }

 
    </style>
    <!--end::manual sidebar-->

</head>
