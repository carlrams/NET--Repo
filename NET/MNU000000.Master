        <script type="text/javascript">


            // show manual sidebar 
            document.addEventListener('DOMContentLoaded', function () {
                const ManualDrawer = document.getElementById('ManualTooltip');
                const sidebarDiv = document.getElementById('ciis_sidebar');
                const interfaceDiv = document.getElementById('ciis_interface');
                const videotutorialsDiv = document.getElementById('ciis_video_tutorials');
                const versioncomparisonDiv = document.getElementById('ciis_version_comparison');
                const currentPage = window.location.pathname.toLowerCase();
                const ManualHome = "doc030200";
                const ManualInterface = "doc030300";
                const VideoTutorials = "doc030400";
                const VersionComparison = "doc030500";

                if (currentPage.includes(ManualHome)) {
                    // Remove 'd-none' if on the target page
                    sidebarDiv.classList.remove('d-none');
                    ManualDrawer.classList.add('d-none');

                } else if (currentPage.includes(ManualInterface)) {
                    // Remove 'd-none' if on the target page
                    interfaceDiv.classList.remove('d-none');
                    ManualDrawer.classList.add('d-none');
                    searchinterface();

                } else if (currentPage.includes(VideoTutorials)) {
                    // Remove 'd-none' if on the target page
                    videotutorialsDiv.classList.remove('d-none');
                    ManualDrawer.classList.add('d-none');
                    searchvideotutorials();

                } else if (currentPage.includes(VersionComparison)) {
                    // Remove 'd-none' if on the target page
                    versioncomparisonDiv.classList.remove('d-none');
                    ManualDrawer.classList.add('d-none');
                    searchversioncomparison();

                } else {
                    // Add 'd-none' if on other pages
                    sidebarDiv.classList.add('d-none');
                    interfaceDiv.classList.add('d-none');
                    videotutorialsDiv.classList.add('d-none');
                }

                const navLinks = document.querySelectorAll('#kt_sidebar .nav-item a, #kt_interface .nav-item a, #kt_video_tutorials .nav-item a, #kt_version_comparison .nav-item a');

                navLinks.forEach(link => {
                    link.addEventListener('click', function (event) {
                        event.preventDefault(); // Prevent default link behavior

             
                        const targetId = this.getAttribute('href').substring(1); // Get ID from href
                        const targetElement = document.getElementById(targetId);
                        if (targetElement) {
                            targetElement.scrollIntoView({ behavior: 'smooth' });
                        }

                        // Remove active class from all links
                        navLinks.forEach(nav => nav.classList.remove('active'));

                        // Add active class to the clicked link
                        this.classList.add('active');
                    });
                });
            });

            //sidebar search
            var prm = Sys.WebForms.PageRequestManager.getInstance();
            prm.add_endRequest(function () {
                // re-bind your jQuery events here
                loadscript();
            });
            $(document).ready(loadscript);

            //mode
            function fnMode() {
                Swal.fire({
                    text: 'Adjust Screen size?',
                    icon: 'question',
                    iconColor: '#0095e8',
                    buttonsStyling: false,
                    showCancelButton: true,
                    confirmButtonText: "Yes",
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-sm btn-info min-w-100px',
                        cancelButton: 'btn btn-sm btn-light-danger min-w-100px'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            type: "POST",
                            url: "HNDGEN.ashx",
                            data: {
                                'pType': 'Mode'
                            },
                            success: function (response) {
                                loadmode(response[0].Mode);
                            }
                        });
                    };
                });
            };
            function loadmode(mode) {
                document.querySelectorAll(".container-xxl, .container-fluid").forEach(el => {
                    if (mode === "container-xxl") {
                        el.classList.remove("container-fluid");
                        el.classList.add("container-xxl");
                    } else if (mode === "container-fluid") {
                        el.classList.remove("container-xxl");
                        el.classList.add("container-fluid");
                    };
                });
            };
            //mode

            // manual sidebar search
            function loadscript() {
                const searchInput = document.getElementById("tbxSearchManual");
                const listItems = document.querySelectorAll("#sidebarList li");

                searchInput.addEventListener("keyup", function () {
                    const filter = searchInput.value.toLowerCase();

                    listItems.forEach((item) => {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
            function searchinterface() {
                const searchInput = document.getElementById("tbxSearchInterface");
                const listItems = document.querySelectorAll("#interfaceList li");

                searchInput.addEventListener("keyup", function () {
                    const filter = searchInput.value.toLowerCase();

                    listItems.forEach((item) => {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
            function searchvideotutorials() {
                const searchInput = document.getElementById("tbxSearchVideoTutorials");
                const listItems = document.querySelectorAll("#videotutorialsList li");

                searchInput.addEventListener("keyup", function () {
                    const filter = searchInput.value.toLowerCase();

                    listItems.forEach((item) => {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
            function searchversioncomparison() {
                const searchInput = document.getElementById("tbxSearchVersionComparison");
                const listItems = document.querySelectorAll("#versioncomparisonList li");

                searchInput.addEventListener("keyup", function () {
                    const filter = searchInput.value.toLowerCase();

                    listItems.forEach((item) => {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }

            function btnSearch(Btn) {
                Btn.disabled = true;
                setTimeout(() => {
                    Btn.disabled = false;
                }, 3000);
                //values
                var tbxFLTR_Search = document.getElementById("tbxFLTR_Search");
                var tbxFLTR_FormNo = document.getElementById("tbxFLTR_FormNo");
                var ddlFLT_FormType = document.getElementById("ddlFLT_FormType");
                var tbxFLTR_DateRequested_From = document.getElementById("tbxFLTR_DateRequested_From");
                var tbxFLTR_DateRequested_To = document.getElementById("tbxFLTR_DateRequested_To");
                var tbxFLTR_DateRequired_From = document.getElementById("tbxFLTR_DateRequired_From");
                var tbxFLTR_DateRequired_To = document.getElementById("tbxFLTR_DateRequired_To");
                var ddlFLT_RequestedBy = document.getElementById("ddlFLT_RequestedBy");
                var ddlFLT_AssignedTo = document.getElementById("ddlFLT_AssignedTo");
                var ddlFLT_Status = document.getElementById("ddlFLT_Status");
                var tbxFLT_Title = document.getElementById("tbxFLT_Title");
                var ddlFLT_MonitoredBy = document.getElementById("ddlFLT_MonitoredBy");
                var ddlFLT_EndorsedBy = document.getElementById("ddlFLT_EndorsedBy");
                var ddlFLT_ApprovedBy = document.getElementById("ddlFLT_ApprovedBy");
                var ddlFLT_ImplementedBy = document.getElementById("ddlFLT_ImplementedBy");
                //initial load
                $.ajax({
                    type: "POST",
                    url: "HNDMNU.ashx",
                    data: {
                        'FormCode': 'MNU',
                        'Type': 'Search',
                        'Search': tbxFLTR_Search.value,
                        'FormNo': tbxFLTR_FormNo.value,
                        'FormType': ddlFLT_FormType.options[ddlFLT_FormType.selectedIndex].value,
                        'DateRequestedFrom': tbxFLTR_DateRequested_From.value,
                        'DateRequestedTo': tbxFLTR_DateRequested_To.value,
                        'DateRequiredFrom': tbxFLTR_DateRequired_From.value,
                        'DateRequiredTo': tbxFLTR_DateRequired_To.value,
                        'RequestedBy': ddlFLT_RequestedBy.options[ddlFLT_RequestedBy.selectedIndex].value,
                        'AssignedTo': ddlFLT_AssignedTo.options[ddlFLT_AssignedTo.selectedIndex].value,
                        'Status': ddlFLT_Status.options[ddlFLT_Status.selectedIndex].value,
                        'Title': tbxFLT_Title.value,
                        'MonitoredBy': ddlFLT_MonitoredBy.options[ddlFLT_MonitoredBy.selectedIndex].value,
                        'EndorsedBy': ddlFLT_EndorsedBy.options[ddlFLT_EndorsedBy.selectedIndex].value,
                        'ApprovedBy': ddlFLT_ApprovedBy.options[ddlFLT_ApprovedBy.selectedIndex].value,
                        'ImplementedBy': ddlFLT_ImplementedBy.options[ddlFLT_ImplementedBy.selectedIndex].value
                    },
                    success: function (response) {
                        $('#tableShow').removeClass('d-none');
                        $('#tableSearch').DataTable().destroy();
                        Display(response);
                    },
                });
                function Display(response) {
                    //disable column type detection
                    DataTable.types().forEach(type => {
                        DataTable.type(type, 'detect', () => false);
                    });
                    //disable column type detection

                    //sort date by yyyy/mm/dd
                    $.fn.dataTable.moment('MM/DD/YYYY');
                    //sort date by yyyy/mm/dd

                    //datatable
                    var tableSearch = $("#tableSearch").DataTable({
                        bFilter: true,
                        bPaginate: false,
                        bInfo: false,
                        scrollCollapse: true,
                        scrollResize: true,
                        scrollX: true,
                        scrollY: 100,
                        paging: false,
                        lengthChange: false,
                        fixedColumns: { left: 1 },
                        select: false,
                        data: response,
                        columns: [
                            { data: 'Link' },
                            { data: 'Title' },
                            { data: 'Type' },
                            { data: 'DateRequired' },
                            { data: 'AssignedTo' },
                            { data: 'ExpectedDate' },
                            { data: 'ApprovalStatus' },
                            { data: 'RequestedBy' },
                            { data: 'FormStatus' }],
                        order: [],
                        columnDefs: [
                            {
                                targets: 0,
                                className: 'tbody-nowrap-auto'
                            },
                            {
                                targets: 1,
                                className: 'tbody-nowrap-auto',
                                render: function (data, type, row) {
                                    return `<span class="tbody-nowrap-auto" title="${data}">${data}</span>`;
                                }
                            },
                            {
                                targets: 4,
                                className: 'tbody-nowrap-auto'
                            },
                            {
                                targets: 7,
                                className: 'tbody-nowrap-auto'
                            }
                        ],
                        orderCellsTop: true
                    });
                    //datatable
                }
                //initial load
            };

            function RPTDSB001() {
                fnAccess('RPTDSB001', 'View', function (response) {
                    if (response[0].oReturn == "1") {
                        window.open("https://app.powerbi.com/view?r=eyJrIjoiY2EzN2ZkMWItMWY4MC00MGU0LTliOTYtM2IyZmE1YWE0YWJhIiwidCI6IjkwNTcwZDllLWEzNGUtNGQ5Ni04MGNkLTljZGRiMDM3MDZiZiIsImMiOjEwfQ%3D%3D", target = "_blank");
                    }
                    else {
                        location.replace("MNU000022");
                    }
                });
            }
            function RPTDSB002() {
                fnAccess('RPTDSB002', 'View', function (response) {
                    if (response[0].oReturn == "1") {
                        window.open("https://app.powerbi.com/view?r=eyJrIjoiN2U4ZTYxZDYtY2RiNC00ZjE5LWIxYzQtZGNmYzIxNDNlYTkwIiwidCI6IjkwNTcwZDllLWEzNGUtNGQ5Ni04MGNkLTljZGRiMDM3MDZiZiIsImMiOjEwfQ%3D%3D", target = "_blank");
                    }
                    else {
                        location.replace("MNU000022");
                    }
                });
            }
            function RPTDSB003() {
                fnAccess('RPTDSB003', 'View', function (response) {
                    if (response[0].oReturn == "1") {
                        window.open("https://app.powerbi.com/view?r=eyJrIjoiYzIxZGRkZjItMTE5YS00YjExLTlkY2YtZTJkZTFjNmM3MjEzIiwidCI6IjkwNTcwZDllLWEzNGUtNGQ5Ni04MGNkLTljZGRiMDM3MDZiZiIsImMiOjEwfQ%3D%3D", target = "_blank");
                    }
                    else {
                        location.replace("MNU000022");
                    }
                });
            }
            function RPTDSB007() {
                fnAccess('RPTDSB007', 'View', function (response) {
                    if (response[0].oReturn == "1") {
                        window.open("https://app.powerbi.com/view?r=eyJrIjoiMzM5NWQyNDQtMzI0OS00N2ZlLTk0N2ItY2EzMDY4NTBhN2U5IiwidCI6IjkwNTcwZDllLWEzNGUtNGQ5Ni04MGNkLTljZGRiMDM3MDZiZiIsImMiOjEwfQ%3D%3D", target = "_blank");
                    }
                    else {
                        location.replace("MNU000022");
                    }
                });
            }
            function initNotifTooltips() {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                        bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl, { container: 'body' });
                    }
                });
            }

            function normalizeNotifications() {
                $(".js-notif-list-new > div, .js-notif-list-previous > div").each(function () {
                    var $item = $(this);

                    if (!$item.hasClass("notification-item")) {
                        $item.addClass("notification-item");
                    }
                    var existingCat = ($item.attr("data-notif-category") || "").toLowerCase().trim();
                    if (!existingCat) {
                        var text = $item.text().toLowerCase();
                        var inferredCat = "formupdates";

                        if (text.indexOf("approved") >= 0 || text.indexOf("endorsed") >= 0 || text.indexOf("declined") >= 0 || text.indexOf("approval") >= 0) {
                            inferredCat = "approvals";
                        } else if (text.indexOf("mentioned") >= 0 || text.indexOf("menitioned") >= 0) {
                            inferredCat = "mentions";
                        } else if (text.indexOf("module") >= 0 || text.indexOf("system") >= 0) {
                            inferredCat = "moduleupdates";
                        } else if (text.indexOf("completed") >= 0 || text.indexOf("pr#") >= 0 || text.indexOf("lv#") >= 0 || text.indexOf("bts") >= 0 || text.indexOf("form") >= 0 || text.indexOf("work order") >= 0) {
                            inferredCat = "formupdates";
                        }

                        $item.attr("data-notif-category", inferredCat);
                    }
                });
            }

            function clearNotificationDots() {
                $("[id$='spnNotifier'], [id$='spnFilterAll'], [id$='spnFilterApprovals'], [id$='spnFilterMentions'], [id$='spnFilterFormUpdates'], [id$='spnFilterModuleUpdates']").hide();

                var $activeBtn = $(".notif-filter-btn.active").first();
                if ($activeBtn.length === 0) {
                    $activeBtn = $(".notif-filter-btn.btn-primary").first();
                }
                if ($activeBtn.length === 0) {
                    $activeBtn = $("[id$='btnFilterAll']").first();
                }

                var activeCategory = $activeBtn.attr("data-category") || "ALL";

                $(".js-notif-list-new .notification-item").each(function () {
                    var $item = $(this);
                    var oldId = $item.attr("id") || "";

                    if (oldId.indexOf("ReadDiv") === 0) {
                        var seq = oldId.replace("ReadDiv", "");
                        $item.attr("id", "UnreadDiv" + seq);

                        var $anchor = $item.find("a[id='ReadA" + seq + "']");
                        if ($anchor.length > 0) {
                            $anchor.attr("id", "UnreadA" + seq);
                            $anchor.attr("onclick", "MarkAsUnread(this.id)");
                            $anchor.attr("title", "Mark as unread");
                        }
                    }

                    $(".js-notif-list-previous").prepend($item);
                });

                $(".js-notif-new").hide();
                $(".js-notif-nothing").show();

                filterNotifications(activeCategory, $activeBtn.get(0));
            }

            function filterNotifications(category, element) {
                normalizeNotifications();

                $(".notif-filter-btn").removeClass("active btn-primary").addClass("btn-light");
                if (element) {
                    $(element).addClass("active btn-primary").removeClass("btn-light");
                } else {
                    $("[data-category='" + category + "']").addClass("active btn-primary").removeClass("btn-light");
                }

                var targetCat = (category || "ALL").toLowerCase().replace(/\s+/g, "");

                $(".notification-item").each(function () {
                    var $item = $(this);
                    var itemCat = ($item.attr("data-notif-category") || "").toLowerCase().trim().replace(/\s+/g, "");
                    var itemText = $item.text().toLowerCase();

                    var match = false;

                    if (targetCat === "all") {
                        match = true;
                    } else if (itemCat !== "") {
                        match = (itemCat === targetCat);
                    } else {
                        if (targetCat === "approvals") {
                            match = (itemText.indexOf("approved") >= 0 || itemText.indexOf("endorsed") >= 0 || itemText.indexOf("declined") >= 0 || itemText.indexOf("approval") >= 0);
                        } else if (targetCat === "mentions") {
                            match = (itemText.indexOf("mentioned") >= 0 || itemText.indexOf("menitioned") >= 0);
                        } else if (targetCat === "formupdates") {
                            match = (itemText.indexOf("pr#") >= 0 || itemText.indexOf("completed") >= 0 || itemText.indexOf("form") >= 0 || itemText.indexOf("lv#") >= 0 || itemText.indexOf("bts") >= 0);
                        } else if (targetCat === "moduleupdates") {
                            match = (itemText.indexOf("module") >= 0 || itemText.indexOf("system") >= 0);
                        }
                    }

                    if (match) {
                        $item.show();
                    } else {
                        $item.hide();
                    }
                });

                var newTotal = $(".js-notif-list-new .notification-item").length;
                var newVisible = $(".js-notif-list-new .notification-item:visible").length;

                if (newTotal === 0) {
                    $(".js-notif-new").hide();
                    $(".js-notif-nothing").show();
                } else if (newVisible > 0) {
                    $(".js-notif-new").show();
                    $(".js-notif-nothing").hide();
                } else {
                    $(".js-notif-new").hide();
                    $(".js-notif-nothing").hide();
                }

                var prevTotal = $(".js-notif-list-previous .notification-item").length;
                var prevVisible = $(".js-notif-list-previous .notification-item:visible").length;

                if (prevTotal > 0 && prevVisible > 0) {
                    $(".js-notif-previous").show();
                } else {
                    $(".js-notif-previous").hide();
                }
            }

            $(document).ready(function () {
                initNotifTooltips();

                var listPrev = document.getElementById("divNotificationListPrevious");
                var listNew = document.getElementById("divNotificationListNew");

                if (listPrev || listNew) {
                    var observer = new MutationObserver(function () {
                        var $activeBtn = $(".notif-filter-btn.active").first();
                        if ($activeBtn.length === 0) {
                            $activeBtn = $(".notif-filter-btn.btn-primary").first();
                        }
                        var activeCat = $activeBtn.attr("data-category") || "ALL";

                        filterNotifications(activeCat, $activeBtn.get(0));
                        initNotifTooltips();
                    });

                    var config = { childList: true };
                    if (listPrev) observer.observe(listPrev, config);
                    if (listNew) observer.observe(listNew, config);
                }
            });
        </script>

