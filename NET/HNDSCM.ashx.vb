                    Action.Append("      <button class='btn btn-sm btn-icon btn-delete' title='Delete' onclick=""fn010104Delete('" & DR("ItemCode") & "', '" & DR("VenCode") & "'); fn01DisableToggle(); return false;""><i class='las la-trash fs-3'></i></button>")
                    Action.Append("      <button class='btn btn-sm btn-icon btn-edit' title='Edit' onclick=""fn010104Edit('" & DR("ItemCode") & "', '" & DR("VenCode") & "'); fn01DisableToggle(); return false;""><i class='las la-pencil-alt fs-3'></i></button>")
                    Action.Append("   </div>")
                    Action.Append("</div>")

                    RecordList.Add(New With {
                        .Action = Action.ToString(),
