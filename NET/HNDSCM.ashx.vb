        Query.Append("      left join Mstr_Work on Trxn_CEDtl.WCode = Mstr_Work.WCode ")
        Query.Append("  where ")
        Query.Append("      Trxn_CEDtl.CECode = '" & pID & "' ")
        Query.Append("  union ")
        Query.Append("  select ")
        Query.Append("      Trxn_CEDtl.CECode ")
        Query.Append("      ,Trxn_CEDtl.ItemNo [ItmNo] ")
        Query.Append("      ,Trxn_CEDtl.SeqNo ")
        Query.Append("      ,Mstr_Work.WNo [ItemNo] ")
        Query.Append("      ,'' [No] ")
        Query.Append("      ,Trxn_CEDtl.Particular ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.Cost, 'N', 'en-us') [Cost] ")
        Query.Append("      ,sys_um.abbr [UOM] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.Qty + Trxn_CEDtl.QtyRev, 'N', 'en-us') [QtyOverall] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.Total + Trxn_CEDtl.TotalRev, 'N', 'en-us') [TotalOverall] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.Qty, 'N', 'en-us') [Qty] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.Total, 'N', 'en-us') [Total] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.QtyRev, 'N', 'en-us') [QtyRev] ")
        Query.Append("      ,FORMAT(Trxn_CEDtl.TotalRev, 'N', 'en-us') [TotalRev] ")
