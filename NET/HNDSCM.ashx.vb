        Query.Append("  ,[ItmNo] ")
        Query.Append("  ,[SeqNo] ")
        Query.Append("  ,(case when [SeqNo] = '0' then [ItemNo] else [No] end) [No] ")
        Query.Append("  ,[Particular] ")
        Query.Append("  ,[Cost] ")
        Query.Append("  ,[UOM] ")
        Query.Append("  ,[QtyOverall] ")
        Query.Append("  ,[TotalOverall] ")
        Query.Append("  ,[Qty] ")
        Query.Append("  ,[Total] ")
        Query.Append("  ,[QtyRev] ")
        Query.Append("  ,[TotalRev] ")
        Query.Append("  ,[QtyReq] ")
        Query.Append("  ,[TotalReq] ")
        Query.Append("  ,[QtyPO] ")
        Query.Append("  ,[TotalPO] ")
        Query.Append("  ,[QtyUsed] ")
        Query.Append("  ,[TotalUsed] ")
        Query.Append("  ,[Type] ")
        Query.Append("  ,[Budget] ")
        Query.Append("  ,[Release] ")
