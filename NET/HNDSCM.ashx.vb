        Query.Append("  ,ogm_wtran_hdr.created_by [CreatedBy] ")
        Query.Append("  ,Format(ogm_wtran_hdr.created_date, 'MM/dd/yyyy') [CreatedDate] ")
        Query.Append("  ,(case when ogm_wtran_hdr.Lock = 1 and ogm_wtran_hdr.Post = 0 and ogm_wtran_hdr.rvrs = 0 then 'Locked' when ogm_wtran_hdr.Post = 1 and ogm_wtran_hdr.Lock = 1 and ogm_wtran_hdr.rvrs = 0 then 'Posted' when ogm_wtran_hdr.rvrs = 1 and ogm_wtran_hdr.Post = 1 and ogm_wtran_hdr.Lock = 1 then 'Cancelled' when ogm_wtran_hdr.Lock is null and ogm_wtran_hdr.Post = 0 and ogm_wtran_hdr.rvrs = 0 then 'Unlocked' else 'New' end) [RecordStatus] ")
        Query.Append("  ,ogm_wtran_hdr.UpdatedBy ")
        Query.Append("  ,[update].fullname [UpdatedByName] ")
        Query.Append("  ,FORMAT(ogm_wtran_hdr.UpdatedDate,'MM/dd/yyyy hh:mm tt') [UpdatedDate] ")
