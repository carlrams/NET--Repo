#Region "Upload"

#Region "PO010101"
    Private Function SCM060100_Upl_Purchase_Order(ID, FileName, Attachment)

        'variable
        Dim FileNames As String() = FileName.Split(","c)
        Dim Files As New List(Of String)

        Dim Attachments As String() = Attachment.split(","c)
        Dim Attach As New List(Of String)
        'variable

        'loop
        For Each file As String In FileNames
            Files.Add(file)
        Next
        For Each based64 As String In Attachments
            Attach.Add(based64)
        Next
        'loop

        'upload
        For Each file As String In Files
            For Each based64 As String In Attach
                Try
                    ' Convert Base64 string to a byte array
                    Dim imageBytes As Byte() = Convert.FromBase64String(based64.Replace("[", "").Replace("]", "").Replace("""", ""))

                    ' Create SQL connection
                    Dim ConnString As String = "Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password
                    Using SqlConn As New SqlConnection(ConnString)
                        ' SQL Query with parameters
                        Dim Query As String = "INSERT INTO Trxn_PODtl_Attachment (POCode, SeqNo, FileName, Attachment) " &
                                              "VALUES (@POCode, (SELECT ISNULL(MAX(SeqNo), 0) + 1 FROM Trxn_PODtl_Attachment WHERE POCode = @POCode), @FileName, @Attachment)"

                        ' Create Command
                        Using SqlCmd As New SqlCommand(Query, SqlConn)
                            ' Add parameters to prevent SQL injection
                            SqlCmd.Parameters.Add("@POCode", SqlDbType.VarChar).Value = ID
                            SqlCmd.Parameters.Add("@FileName", SqlDbType.VarChar).Value = FileName.Replace("[", "").Replace("]", "").Replace("""", "")
                            SqlCmd.Parameters.Add("@Attachment", SqlDbType.Image).Value = imageBytes

                            ' Open connection and execute query
                            SqlConn.Open()
                            SqlCmd.ExecuteNonQuery()
                        End Using
                    End Using

                Catch ex As Exception
                    ' Handle errors
                    Console.WriteLine("Error: " & ex.Message)
                End Try
            Next
        Next
        'upload
    End Function
