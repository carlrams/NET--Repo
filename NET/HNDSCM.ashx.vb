    Function SCM070100_Return_Record(pID)

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("	IRDtl.PRNo ")
        Query.Append("	,IRDtl.PRSeqNo ")
        Query.Append("	,IRDtl.PONo ")
        Query.Append("	,IRDtl.POSeqNo ")
        Query.Append("	,ogm_por_hdr.reference [RRNo] ")
        Query.Append("	,IRDtl.SeqNo [RRSeqNo] ")
        Query.Append("	,IRDtl.SIDRNo ")
        Query.Append("	,IRDtl.Type ")
        Query.Append("	,IRDtl.ItemName ")
        Query.Append("	,IRDtl.Qty ")
        Query.Append("	,IRDtl.UMInit ")
        Query.Append("from ")
        Query.Append("	IRDtl ")
        Query.Append("	left join ogm_por_hdr on IRDtl.IRCode = ogm_por_hdr.r_code ")
        Query.Append("where ")
        Query.Append("	ogm_por_hdr.Post = 1 ")
        Query.Append("	and ogm_por_hdr.rvrs = 0 ")
        Query.Append("	and isnull(ogm_por_hdr.Origin,'PO') = 'PO' ")
        'Query.Append("	and DATEDIFF(month,ogm_por_hdr.trx_date,GETDATE()) between 0 and 3 ")
        Query.Append("	and ogm_por_hdr.r_code = '" & pID & "' ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    Dim Action As New StringBuilder
                    Action.Append("<div class='d-flex justify-content-center form-check form-check-sm form-check-custom form-check-solid'><input class='form-check-input widget-9-check cbxRT010601' type='checkbox' value='" & DR("RRNo") & "' data-kt-no='" & DR("RRSeqNo") & "' /></div>")

                    RecordList.Add(New With {
                        .rowId = "rowID010601" & DR("RRNo") & DR("RRSeqNo"),
                        .Action = Action.ToString,
                        .PRNo = DR("PRNo"),
                        .PRSeqNo = DR("PRSeqNo"),
                        .PONo = DR("PONo"),
                        .POSeqNo = DR("POSeqNo"),
                        .RRNo = DR("RRNo"),
                        .RRSeqNo = DR("RRSeqNo"),
                        .SIDRNo = DR("SIDRNo"),
                        .Type = DR("Type"),
                        .ItemName = DR("ItemName"),
                        .Qty = DR("Qty"),
                        .Return = DR("Qty"),
                        .UMInit = DR("UMInit"),
                        .Remarks = ""
                    })

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'set to max
        Return JsonConvert.SerializeObject(RecordList, Formatting.None)
        'display 

    End Function
