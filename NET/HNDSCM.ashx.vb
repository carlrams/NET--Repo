        Query.Append("  ,ogm_vendor.vendor [VenName] ")
        Query.Append("  ,ogm_po_hdr.status [Status] ")
        Query.Append("  ,(SELECT TOP 1 IRDtl.IRNo FROM IRDtl WHERE IRDtl.POCode = ogm_po_hdr.po_code AND IRDtl.Post = 1 AND IRDtl.Cancelled = 0 ORDER BY IRDtl.IRDate DESC) [RRNo] ")
        Query.Append("  ,ogm_po_hdr.OnlineReference [OnlineReferenceNo] ")
