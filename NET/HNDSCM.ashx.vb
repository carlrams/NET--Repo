        Query.Append("  ,[CvxQty] ")
        Query.Append("  ,ISNULL((select abbr from sys_um where u_code = [CvxUnit]), '') [CvxUnit] ")
        Query.Append("from ")
        Query.Append("  (select distinct ")
        Query.Append("      '' [CECode] ")
        Query.Append("      ,'' [ItmNo] ")
        Query.Append("      ,0 [SeqNo] ")
        Query.Append("      ,Mstr_Work.WNo [ItemNo] ")
        Query.Append("      ,Mstr_Work.WNo [No] ")
        Query.Append("      ,Mstr_Work.Description [Particular] ")
        Query.Append("      ,'' [Cost] ")
        Query.Append("      ,'' [UOM] ")
        Query.Append("      ,'' [QtyOverall] ")
        Query.Append("      ,'' [TotalOverall] ")
        Query.Append("      ,'' [Qty] ")
        Query.Append("      ,'' [Total] ")
        Query.Append("      ,'' [QtyRev] ")
        Query.Append("      ,'' [TotalRev] ")
        Query.Append("      ,'' [QtyReq] ")
        Query.Append("      ,'' [TotalReq] ")
        Query.Append("      ,'' [QtyPO] ")
        Query.Append("      ,'' [TotalPO] ")
        Query.Append("      ,'' [QtyUsed] ")
        Query.Append("      ,'' [TotalUsed] ")
        Query.Append("      ,'' [Type] ")
        Query.Append("      ,'' [Budget] ")
        Query.Append("      ,'' [Release] ")
        Query.Append("      ,'' [Actualize] ")
        Query.Append("      ,'' [Commitment] ")
        Query.Append("      ,'' [CvxCode] ")
        Query.Append("      ,'' [CvxQty] ")
        Query.Append("      ,'' [CvxUnit] ")
        Query.Append("  from ")
