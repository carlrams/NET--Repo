    Function SCM070100_Get_Info_DTL(pID)

        'get query
        Dim Query As New StringBuilder
        Query.Append("Select ")
        Query.Append("  ogm_por_hdr.r_code [IRCode] ")
        Query.Append("  ,ogm_por_hdr.reference [RRNo] ")
        Query.Append("  ,Format(ogm_por_hdr.trx_date, 'MM/dd/yyyy') [RRDate] ")
        Query.Append("  ,Format(ogm_por_hdr.ORDate, 'MM/dd/yyyy') [ORDate] ")
        Query.Append("  ,ogm_por_hdr.warehouse [WhseCode] ")
        Query.Append("  ,ogm_warehouse.warehouse [WhseName] ")
        Query.Append("  ,isnull(ogm_por_hdr.Origin,'PO') [Origin] ")
        Query.Append("  ,ogm_por_hdr.vendor [VenCode] ")
        Query.Append("  ,(case ogm_por_hdr.Origin when 'PO' then [PO].vendor when 'CP' then [CP].form_no when 'WT' then [WT].warehouse when 'Return' then [Return].form_no else 'N/A' end) [VenName] ")
        Query.Append("  ,ogm_por_hdr.CPVendor ")
        Query.Append("  ,ogm_por_hdr.COMat ")
        Query.Append("  ,ogm_por_hdr.TLEqu ")
        Query.Append("  ,ogm_por_hdr.FFEqu ")
        Query.Append("  ,(select emp_no from employee where fullname = ogm_por_hdr.ReceivedBy) [ReceivedByCode] ")
        Query.Append("  ,ogm_por_hdr.ReceivedBy ")
        Query.Append("  ,ogm_por_hdr.CheckedBy [CheckedCode] ")
        Query.Append("  ,[che].fullname [CheckedName] ")
        Query.Append("  ,ogm_por_hdr.VerifiedBy [VerifiedCode] ")
        Query.Append("  ,[ver].fullname [VerifiedName] ")
        Query.Append("  ,ogm_por_hdr.CreatedBy ")
        Query.Append("  ,ogm_por_hdr.CreatedDate ")
        Query.Append("  ,ogm_por_hdr.UpdatedBy ")
        Query.Append("  ,FORMAT(ogm_por_hdr.UpdatedDate,'MM/dd/yyyy hh:mm tt') [UpdatedDate] ")
        Query.Append("  ,ogm_por_hdr.LockedBy ")
        Query.Append("  ,FORMAT(ogm_por_hdr.LockedDate,'MM/dd/yyyy hh:mm tt') [LockedDate] ")
        Query.Append("  ,ogm_por_hdr.lock [Lock] ")
        Query.Append("  ,ogm_por_hdr.PostedBy ")
        Query.Append("  ,FORMAT(ogm_por_hdr.PostedDate,'MM/dd/yyyy hh:mm tt') [PostedDate] ")
        Query.Append("  ,ogm_por_hdr.post [Post] ")
        Query.Append("  ,ogm_por_hdr.rvrs_by [ReversedBy] ")
        Query.Append("  ,FORMAT(ogm_por_hdr.rvrs_date,'MM/dd/yyyy hh:mm tt') [ReversedDate] ")
        Query.Append("  ,ogm_por_hdr.Rvrs ")
        Query.Append("  ,[UPD].fullname [UpdatedByName] ")
        Query.Append("  ,[LCK].fullname [LockedByName] ")
        Query.Append("  ,[PST].fullname [PostedByName] ")
        Query.Append("  ,[RVRS].fullname [CancelledByName] ")
        Query.Append("  ,(case when ogm_por_hdr.lock = 1 and ogm_por_hdr.Post = 0 and ogm_por_hdr.Rvrs = 0 then 'Locked' when ogm_por_hdr.post = 1 and ogm_por_hdr.lock = 1 and ogm_por_hdr.Rvrs = 0 then 'Posted' when ogm_por_hdr.Rvrs = 1 and ogm_por_hdr.lock = 1 and ogm_por_hdr.post = 1 then 'Cancelled' else 'New' end) [RecordStatus] ")
        Query.Append("from ")
        Query.Append("  ogm_por_hdr ")
        Query.Append("  left join ogm_warehouse on ogm_por_hdr.warehouse = ogm_warehouse.w_code ")
        Query.Append("  left join ogm_vendor [PO] on ogm_por_hdr.vendor = [PO].v_code ")
        Query.Append("  left join ogm_pr_hdr [CP] on ogm_por_hdr.vendor = [CP].pr_code ")
        Query.Append("  left join ogm_warehouse [WT] on ogm_por_hdr.vendor = [WT].w_code ")
        Query.Append("  left join ogm_pr_hdr [Return] on ogm_por_hdr.vendor = [Return].pr_code ")
        Query.Append("  left join employee [che] on ogm_por_hdr.CheckedBy = [che].emp_no ")
        Query.Append("  left join employee [ver] on ogm_por_hdr.VerifiedBy = [ver].emp_no ")
        Query.Append("  left join employee [UPD] on ogm_por_hdr.UpdatedBy = [UPD].emp_no ")
        Query.Append("  left join employee [LCK] on ogm_por_hdr.LockedBy = [LCK].emp_no ")
        Query.Append("  left join employee [PST] on ogm_por_hdr.PostedBy = [PST].emp_no ")
        Query.Append("  left join employee [RVRS] on ogm_por_hdr.rvrs_by = [RVRS].emp_no ")
        Query.Append("where ")
        Query.Append("  ogm_por_hdr.r_code = '" & pID & "' ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {
                        .IRCode = DR("IRCode"),
