    Function SCM070100_Add_Get_Record(pID, pSIDRNo, pType, pItemCode, pQty, pForSI, pForSIBalance, pUnit, pCost, pTotal, pRemarks, pCreatedBy, pUpdatedBy)

        'add
        Dim Query As New StringBuilder
        Query.Append("declare @pID nvarchar(13) = '" & pID & "' ")
        Query.Append("declare @pSeqNo tinyint = (isnull((select top 1 SeqNo from ogm_por_dtl where r_code = @pID order by SeqNo desc),0) + 1) ")
        Query.Append("INSERT INTO ogm_por_dtl ")
        Query.Append("  (r_code ")
        Query.Append("  ,SeqNo ")
        Query.Append("  ,SIDRNo ")
        Query.Append("  ,Type ")
        Query.Append("  ,item ")
        Query.Append("  ,qty ")
        Query.Append("  ,ForSI ")
        Query.Append("  ,ForSIBalance ")
        Query.Append("  ,unit ")
        Query.Append("  ,unit_cost ")
        Query.Append("  ,tot_cost ")
        Query.Append("  ,remarks ")
        Query.Append("  ,CreatedBy ")
        Query.Append("  ,CreatedDate ")
        Query.Append("  ,UpdatedBy ")
        Query.Append("  ,UpdatedDate) ")
        Query.Append("VALUES ( ")
        Query.Append("  @pID ")
        Query.Append("  ,@pSeqNo ")
        Query.Append("  ,'" & pSIDRNo & "' ")
        Query.Append("  ,'" & pType & "' ")
        Query.Append("  ,'" & pItemCode & "' ")
        Query.Append("  ," & CDbl(pQty) & " ")
        Query.Append("  ," & IIf(pType = "DI", CDbl(pQty), 0) & " ")
        Query.Append("  ," & IIf(pType = "DI", CDbl(pQty), 0) & " ")
        Query.Append("  ,'" & pUnit & "' ")
        Query.Append("  ," & CDbl(pCost) & " ")
        Query.Append("  ," & CDbl(pTotal) & " ")
        Query.Append("  ,'" & pRemarks.ToString.Replace("'", "''") & "' ")
        Query.Append("  ,'" & pCreatedBy & "' ")
        Query.Append("  ,GETDATE() ")
        Query.Append("  ,'" & pUpdatedBy & "' ")
        Query.Append("  ,GETDATE() ) ")
        Query.Append("select @pID [oID], @pSeqNo [oSeqNo] ")
        'add

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.oID = DR("oID"), .oSeqNo = DR("oSeqNo")})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

