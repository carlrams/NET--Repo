    Function SCM060100_Find_Item_Record()

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("  [A].i_code [ItemCode] ")
        Query.Append("  ,[A].item [ItemName] ")
        Query.Append("  ,ISNULL([A].lock, 0) [Lock] ")
        Query.Append("  ,[A].um [UMCode] ")
        Query.Append("  ,[B].description [UMName] ")
        Query.Append("from ")
        Query.Append("  ogm_item [A] ")
        Query.Append("  left join sys_um [B] on [A].um = [B].u_code ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    Dim Action As New StringBuilder
                    Action.Append("<button class='btn btn-sm btn-icon btn-view mt-1' title='View Record' onclick=""fn010104ViewItem('" & DR("ItemName") & "', '" & DR("ItemCode") & "', '" & DR("UMCode") & "', '" & DR("UMName") & "', '" & DR("Lock") & "');return false;""><i class='las la-search fs-3'></i></button>")

                    RecordList.Add(New With {
                        .Action = Action.ToString,
                        .ItemCode = DR("ItemCode"),
                        .ItemName = DR("ItemName"),
                        .Lock = "<div class='form-check form-check-custom form-check-solid form-check-success w-100 flex-center mt-3'><input class='form-check-input' type='checkbox' value='' " & IIf(DR("Lock") = 1, " checked='checked'", "") & " onclick='return false'/></div>",
                        .UMCode = DR("UMCode"),
                        .UMName = DR("UMName")
                    })

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return JsonConvert.SerializeObject(RecordList, Formatting.None)
        'display

    End Function
    Function SCM060100_Update_Item_Price(pVendor, pOrigItemCode, pItemCode, pUOMCode, pPrice, pDate, pOrigDate, pUpdatedBy)

        'get query
        Dim Query As New StringBuilder
        Query.Append("UPDATE Mstr_ItemPrice SET ")
        Query.Append("  ItemCode = @ItemCode ")
        Query.Append("  ,UMCode = @UMCode ")
        Query.Append("  ,Price = @Price ")
        Query.Append("  ,Date = @Date ")
        Query.Append("  ,CreatedBy = @CreatedBy ")
        Query.Append("  ,CreatedDate = GETDATE() ")
        Query.Append("  ,UpdatedBy = @UpdatedBy ")
        Query.Append("  ,UpdatedDate = GETDATE() ")
        Query.Append("WHERE ")
        Query.Append("  ItemCode = @OrigItemCode ")
        Query.Append("  AND VenCode = @Vendor ")
        Query.Append("  AND Date = @OrigDate ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Parameters.AddWithValue("@ItemCode", pItemCode)
                Cmd.Parameters.AddWithValue("@UMCode", pUOMCode)
                Cmd.Parameters.AddWithValue("@Price", CDbl(pPrice))
                Cmd.Parameters.AddWithValue("@Date", pDate)
                Cmd.Parameters.AddWithValue("@CreatedBy", pUpdatedBy)
                Cmd.Parameters.AddWithValue("@UpdatedBy", pUpdatedBy)
                Cmd.Parameters.AddWithValue("@OrigItemCode", pOrigItemCode)
                Cmd.Parameters.AddWithValue("@Vendor", pVendor)
                Cmd.Parameters.AddWithValue("@OrigDate", pOrigDate)
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {
                        .oItemCode = pItemCode,
                        .oVendor = pVendor,
                        .oDate = pDate
                        })
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
    Function SCM060100_Get_Item_Price_Redraw(pItemCode, pVendor, pDate)

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("  Mstr_ItemPrice.ItemCode ")
        Query.Append("  ,ogm_item.item AS ItemName ")
        Query.Append("  ,Mstr_ItemPrice.UMCode ")
        Query.Append("  ,sys_um.abbr AS UMName ")
        Query.Append("  ,Mstr_ItemPrice.Price ")
        Query.Append("  ,FORMAT(Mstr_ItemPrice.Date, 'MM/dd/yyyy') [Date] ")
        Query.Append("  ,Mstr_ItemPrice.VenCode ")
        Query.Append("  ,Mstr_ItemPrice.CreatedBy ")
        Query.Append("  ,Mstr_ItemPrice.UpdatedBy ")
        Query.Append("  ,Mstr_ItemPrice.UpdatedDate ")
        Query.Append("from ")
        Query.Append("  Mstr_ItemPrice ")
        Query.Append("  LEFT OUTER JOIN sys_um ON Mstr_ItemPrice.UMCode = sys_um.u_code ")
        Query.Append("  LEFT OUTER JOIN ogm_item ON Mstr_ItemPrice.ItemCode = ogm_item.i_code ")
        Query.Append("where ")
        Query.Append("  Mstr_ItemPrice.VenCode = @Vendor ")
        Query.Append("  and Mstr_ItemPrice.ItemCode = @ItemCode ")
        Query.Append("  and Mstr_ItemPrice.Date = @Date ")
        Query.Append("order by ")
        Query.Append("  Mstr_ItemPrice.Date DESC ")
        Query.Append("  ,Mstr_ItemPrice.Price ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Parameters.AddWithValue("@Vendor", pVendor)
                Cmd.Parameters.AddWithValue("@ItemCode", pItemCode)
                Cmd.Parameters.AddWithValue("@Date", pDate)
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    Dim Action As New StringBuilder
                    Action.Append("<div class='action-toggle-wrapper mt-1' style='position: relative; display: inline-block;'>")
