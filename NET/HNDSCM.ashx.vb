        Query.Append("	[WT].PRNo = @PRNo ")
        Query.Append("union ")
        Query.Append("select distinct ")
        Query.Append("	5 [SeqNo] ")
        Query.Append("	,'IR' [Type] ")
        Query.Append("	,[IR].IRCode [Code] ")
        Query.Append("	,[IR].IRNo [No] ")
        Query.Append("	,Format([IR].IRDate, 'MM/dd/yyyy') [Date] ")
