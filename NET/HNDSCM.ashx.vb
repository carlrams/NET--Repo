#Region "SCM040000"
    Private Function SCM040000_Get_List_Stock_Issuance(Posted As String, Warehouse As String)

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("  [A].si_code [SICode] ")
        Query.Append("  , [A].SINo [SINo] ")
        Query.Append("  , Format([A].si_date, 'MM/dd/yyyy') [SIDate] ")
        Query.Append("  ,[A].GPNo [GPNo] ")
        Query.Append("  ,Format([A].GPDate, 'MM/dd/yyyy') [GPDate] ")
        Query.Append("  ,isnull([B].warehouse, '') [Warehouse] ")
        Query.Append("  ,[A].Lock [Lock] ")
        Query.Append("  ,[A].Post [Post] ")
        Query.Append("  ,[A].rvrs [Rvrs] ")
        Query.Append("  ,[C].fullname [RequestedBy] ")
        Query.Append("  ,[D].fullname [UpdatedBy] ")
        Query.Append("from ")
        Query.Append("  ogm_si_hdr [A] ")
        Query.Append("  left join ogm_warehouse [B] on [A].WhseCode = [B].w_code ")
        Query.Append("  left join employee [C] on [A].RequestedBy = [C].emp_no ")
        Query.Append("  left join employee [D] on [A].UpdatedBy = [D].emp_no ")
        Query.Append("where ")
        If Posted = 0 Then
            Query.Append("  [A].Post = 0 ")
        ElseIf Posted = 1 Then
            Query.Append("  [A].Post = 1 ")
        End If
        If Warehouse <> "" Then
            Query.Append("  and [A].WhseCode = '" & Warehouse & "' ")
        End If
        If Posted = 0 Then
            Query.Append("union ")
            Query.Append("select ")
            Query.Append("  [A].si_code [SICode] ")
            Query.Append("  ,[A].SINo [SINo] ")
            Query.Append("  ,Format([A].si_date, 'MM/dd/yyyy') [SIDate] ")
            Query.Append("  ,[A].GPNo [GPNo] ")
            Query.Append("  ,Format([A].GPDate, 'MM/dd/yyyy') [GPDate] ")
            Query.Append("  ,isnull([B].warehouse, '') [Warehouse] ")
            Query.Append("  ,[A].Lock [Lock] ")
            Query.Append("  ,[A].Post [Post] ")
            Query.Append("  ,[A].rvrs [Rvrs] ")
            Query.Append("  ,[C].fullname [RequestedBy] ")
            Query.Append("  ,[D].fullname [UpdatedBy] ")
            Query.Append("from ")
            Query.Append("  ogm_si_hdr [A] ")
            Query.Append("  left join ogm_warehouse [B] on [A].WhseCode = [B].w_code ")
            Query.Append("  left join employee [C] on [A].RequestedBy = [C].emp_no ")
            Query.Append("  left join employee [D] on [A].UpdatedBy = [D].emp_no ")
            Query.Append("where ")
            Query.Append("  [A].Post = 1 ")
            Query.Append("  and datediff(day,[A].PostedDate,getdate()) between 0 and 3 ")
        End If
        'get query

        'variable
        Dim FormList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()
                    FormList.Add(New With {
                        .ID = DR("SICode"),
                        .No = DR("SINo"),
                        .Date = DR("SIDate"),
                        .GPNo = DR("GPNo"),
                        .GPDate = DR("GPDate"),
                        .Warehouse = DR("Warehouse"),
                        .Lock = DR("Lock"),
                        .Post = DR("Post"),
                        .Rvrs = DR("Rvrs"),
                        .RequestedBy = DR("RequestedBy"),
                        .UpdatedBy = DR("UpdatedBy")
                    })
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        'Return (New JavaScriptSerializer().Serialize(FormList))

        'set to max
        Return JsonConvert.SerializeObject(FormList, Formatting.None)
        'display 

    End Function
