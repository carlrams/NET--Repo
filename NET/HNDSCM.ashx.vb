    Function SCM140100_Add_Upload_Record_Material(rows As List(Of Dictionary(Of String, Object))) As String
        Dim RecordList As New List(Of Object)()

        Using SqlConn As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            SqlConn.Open()

            ' Step 1: Get current SeqNo
            Dim RowVal As Boolean = True
            Dim SeqNo As Integer = 0
            'Using CmdMax As New SqlCommand("SELECT ISNULL(MAX(SeqNo),0) FROM Trxn_CEDtl WHERE CECode=@pCECode", SqlConn)
            '    CmdMax.Parameters.AddWithValue("@pCECode", pID)
            '    SeqNo = Convert.ToInt32(CmdMax.ExecuteScalar())
            'End Using

            ' Step 2: Loop over rows
            For Each row As Dictionary(Of String, Object) In rows
                SeqNo += 1

                ' Step 2a: Generate ItemNo using New_Code
                Dim ItemNo As String = ""
                Using CmdNewCode As New SqlCommand("New_Code", SqlConn)
                    CmdNewCode.CommandType = CommandType.StoredProcedure
                    CmdNewCode.Parameters.AddWithValue("@pTblname", "Trxn_CEDtl(ItemNo)")
                    CmdNewCode.Parameters.AddWithValue("@pPreffix", "MN")
                    Dim outParam As New SqlParameter("@oCode", SqlDbType.NVarChar, 50)
                    outParam.Direction = ParameterDirection.Output
                    CmdNewCode.Parameters.Add(outParam)
                    CmdNewCode.ExecuteNonQuery()
                    ItemNo = outParam.Value.ToString()
                End Using

                ' Step 2b: Insert row using New_CEDtl SP
                Using SqlCmd As New SqlCommand("New_CEDtl", SqlConn)
                    SqlCmd.CommandType = CommandType.StoredProcedure
                    SqlCmd.CommandTimeout = 1500

                    SqlCmd.Parameters.AddWithValue("@pCECode", row("CECode").ToString())
                    SqlCmd.Parameters.AddWithValue("@pSeqNo", SeqNo)
                    SqlCmd.Parameters.AddWithValue("@pItemNo", ItemNo)
                    SqlCmd.Parameters.AddWithValue("@pWCode", row("oWorkCode").ToString())
                    SqlCmd.Parameters.AddWithValue("@pTagged", IIf(String.IsNullOrEmpty(row("TblCode").ToString()), 0, 1))
                    SqlCmd.Parameters.AddWithValue("@pType", row("Type").ToString())
                    SqlCmd.Parameters.AddWithValue("@pTblCode", row("TblCode").ToString())
                    SqlCmd.Parameters.AddWithValue("@pParticular", row("Particular").ToString())
                    SqlCmd.Parameters.AddWithValue("@pCost", CDbl(row("Cost").ToString()))
                    SqlCmd.Parameters.AddWithValue("@pUMCode", row("oUMCode").ToString())
                    SqlCmd.Parameters.AddWithValue("@pQty", CDbl(row("Qty").ToString()))
                    SqlCmd.Parameters.AddWithValue("@pTotal", CDbl(row("Total").ToString()))
                    SqlCmd.Parameters.AddWithValue("@pCreatedBy", CIIS_EmpCode)
                    SqlCmd.Parameters.AddWithValue("@pUpdatedBy", CIIS_EmpCode)
                    SqlCmd.Parameters.AddWithValue("@pFirstRow", IIf(RowVal, 1, 0))

                    SqlCmd.ExecuteNonQuery()
                End Using

                ' Step 2c: Update ItemNo after insert
                If row("Category").ToString() = "House Construction" Then
                    SCM140100_Upd_ItemNo(row("CECode").ToString(), SeqNo, row("CENo").ToString())
                End If

                ' Step 2d: Add to JSON record list
                RecordList.Add(New With {
                    .oReturn = "Success"
                })

                RowVal = False
            Next

            SqlConn.Close()
        End Using

        ' Step 3: Return all inserted rows as JSON
        Return (New JavaScriptSerializer().Serialize(RecordList))
    End Function
    Function SCM140100_Upd_ItemNo(pCECode, pSeqNo, pCENo)

        'update
        Dim Query As New StringBuilder
        Query.Append("DECLARE @CECode nvarchar(13) = '" & pCECode & "' ")
        Query.Append("DECLARE @CENo nvarchar(13) = '" & pCENo & "' ")
        Query.Append("DECLARE @SeqNo int = " & pSeqNo & " ")
        Query.Append("UPDATE Trxn_CEDtl SET ")
        Query.Append("  ItemNo = (select top 1 ")
        Query.Append("                  [A].Batch + '-' + [E].abbr + [D].description + 'B' + [C].block + 'L' + [B].lot + '.' + CAST(@SeqNo AS NVARCHAR) + '.' + RIGHT('000' + CAST(ISNULL([G].WNo, 0) AS VARCHAR(3)), 3) ")
        Query.Append("           from ")
        Query.Append("              Trxn_CEHdr [A] ")
        Query.Append("              left join eng_lot [B] on [A].Category in ('House Construction') and [A].Subdivision = [B].l_code ")
        Query.Append("              left join eng_block [C] on [B].b_code = [C].b_code ")
        Query.Append("              left join phase [D] on [B].p_code = [D].code ")
        Query.Append("              left join subdivision [E] on [B].s_code = [E].code ")
        Query.Append("              left join Trxn_CEDtl [F] on [A].CECode = [F].CECode ")
        Query.Append("              left join Mstr_Work [G] on [F].WCode = [G].WCode ")
        Query.Append("          where ")
        Query.Append("              [A].CENo = @CENo ")
        Query.Append("          order by ")
        Query.Append("              [F].SeqNo DESC) ")
        Query.Append("WHERE ")
        Query.Append("  CECode = @CECode ")
        Query.Append("  and SeqNo = @SeqNo ")
        'update

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.Return = "Sucess"})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
