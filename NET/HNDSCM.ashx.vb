    Function SCM140100_Add_Rvrs_Record_Material(pID, pCategory, pCENo, pWCode, pTblCode, pParticular, pCost, pUOMCode, pQty, pTotal, pRemarks, pEstimate, pRequest, pCreatedBy, pUpdatedBy)

        'add query
        Dim Query As New StringBuilder
        Query.Append("declare @pID nvarchar(13) = '" & pID & "' ")
        Query.Append("declare @pSeqNo int = (isnull((select MAX(SeqNo) from Trxn_CERvsn where CECode = @pID),0) + 1) ")
        Query.Append("INSERT INTO Trxn_CERvsn ")
        Query.Append("  (CECode ")
        Query.Append("  ,SeqNo ")
        Query.Append("  ,Type ")
        Query.Append("  ,ItemNo ")
        Query.Append("  ,WCode ")
        Query.Append("  ,Tagged ")
        Query.Append("  ,TblFrom ")
        Query.Append("  ,TblCode ")
        Query.Append("  ,Particular ")
        Query.Append("  ,Cost ")
        Query.Append("  ,UMCode ")
        Query.Append("  ,Qty ")
        Query.Append("  ,Total ")
        Query.Append("  ,Remarks ")
        Query.Append("  ,CreatedBy ")
        Query.Append("  ,CreatedDate ")
        Query.Append("  ,UpdatedBy ")
        Query.Append("  ,UpdatedDate) ")
        Query.Append("VALUES ")
        Query.Append("  (@pID ")
