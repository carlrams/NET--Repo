        Query.Append("  ,Trxn_ItemConvertion.WhseCode ")
        Query.Append("  ,ogm_warehouse.warehouse AS WhseName ")
        Query.Append("  ,Trxn_ItemConvertion.FromItemCode ")
        Query.Append("  ,FItem.item AS FromItemName ")
        Query.Append("  ,Trxn_ItemConvertion.FromQty ")
        Query.Append("  ,Trxn_ItemConvertion.FromUMCode ")
