        Query.Append("  ,isnull(Trxn_ItemConvertion.Rvrs, 0) [Rvrs] ")
        Query.Append("from ")
        Query.Append("  Trxn_ItemConvertion ")
        Query.Append("  LEFT OUTER JOIN ogm_warehouse ON Trxn_ItemConvertion.WhseCode = ogm_warehouse.w_code ")
        Query.Append("  LEFT OUTER JOIN ogm_item AS FItem ON Trxn_ItemConvertion.FromItemCode = FItem.i_code ")
        Query.Append("  LEFT OUTER JOIN sys_um AS FUm ON Trxn_ItemConvertion.FromUMCode = FUm.u_code ")
