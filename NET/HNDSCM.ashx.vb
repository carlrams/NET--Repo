    Function SCM140100_Get_Info_DTL(pID)

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("  Trxn_CEHdr.CECode ")
        Query.Append("  ,Trxn_CEHdr.CENo ")
        Query.Append("  ,Format(Trxn_CEHdr.CEDate, 'MM/dd/yyyy') [CEDate] ")
        Query.Append("  ,Trxn_CEHdr.Title ")
        Query.Append("  ,Trxn_CEHdr.Category ")
        Query.Append("  ,Trxn_CEHdr.Subdivision ")
        Query.Append("  ,(case when Trxn_CEHdr.Category in ('Structural Consultant - Amenities', 'Service Entrance', 'Land Scape Project Restoration', 'Land Scape Project New', 'Land Development Repair', 'Land Development New', 'DOLE Application - Land Development', 'Amenities Repair', 'Amenities New') then [B].abbr + ' ' + [A].description ")
        Query.Append("         when Trxn_CEHdr.Category in ('Shell to Premium', 'Shell to Complete', 'Classic to Premium', 'Shell to classic', 'Shell to Basic', 'Structural Consultant - House Unit', 'NWRB Application', 'Land Scape Unit', 'Interior Designer', 'House Repair', 'House Construction', 'Electrical Consultant', 'DOLE Application - Model House', 'Basic to Complete') then [F].abbr + ' ' + [E].description + ' B' + [D].block + ' L' + [C].lot ")
        Query.Append("         when Trxn_CEHdr.Category in ('CLDC Office') then dbo.ProperCase([G].description) ")
        Query.Append("         when Trxn_CEHdr.Category in ('Waste Hauling Services', 'Utilities Repair', 'Testing and Investigation', 'Temporary Facilities Construction', 'Security Services', 'Container Van', 'Clearing / Grass Cutting') then dbo.ProperCase([H].description) ")
        Query.Append("         else ")
        Query.Append("         subdivision.description end) [SubdivisionName] ")
        Query.Append("  ,ISNULL((CASE WHEN Trxn_CEHdr.Batch = '-' THEN '' ELSE Trxn_CEHdr.Batch END), '') [Batch] ")
        Query.Append("  ,(case when Trxn_CEHdr.Lock = 1 and Trxn_CEHdr.Post = 0 and Trxn_CEHdr.rvrs = 0 then 'Locked' when Trxn_CEHdr.Post = 1 and Trxn_CEHdr.Lock = 1 and Trxn_CEHdr.rvrs = 0 then 'Posted' when Trxn_CEHdr.rvrs = 1 and Trxn_CEHdr.Post = 1 and Trxn_CEHdr.Lock = 1 then 'Cancelled' when Trxn_CEHdr.Lock is null and Trxn_CEHdr.Post = 0 and Trxn_CEHdr.rvrs = 0 then 'Unlocked' else 'New' end) [RecordStatus] ")
        Query.Append("  ,Trxn_CEHdr.CreatedBy ")
        Query.Append("  ,Trxn_CEHdr.CreatedDate ")
        Query.Append("  ,Trxn_CEHdr.UpdatedBy ")
        Query.Append("  ,UEmp.fullname [UpdatedByName] ")
        Query.Append("  ,FORMAT(Trxn_CEHdr.UpdatedDate,'MM/dd/yyyy hh:mm tt') [UpdatedDate] ")
        Query.Append("  ,Trxn_CEHdr.UpdatedDate ")
        Query.Append("  ,Trxn_CEHdr.LockBy ")
        Query.Append("  ,LEmp.fullname [LockedByName] ")
        Query.Append("  ,FORMAT(Trxn_CEHdr.LockDate,'MM/dd/yyyy hh:mm tt') [LockedDate] ")
        Query.Append("  ,isnull(Trxn_CEHdr.Lock, 0) [Lock] ")
        Query.Append("  ,Trxn_CEHdr.PostBy ")
        Query.Append("  ,PEmp.fullname [PostedByName] ")
        Query.Append("  ,FORMAT(Trxn_CEHdr.PostDate,'MM/dd/yyyy hh:mm tt') [PostedDate] ")
        Query.Append("  ,isnull(Trxn_CEHdr.Post, 0) [Post] ")
        Query.Append("  ,Trxn_CEHdr.RvrsRemarks ")
        Query.Append("  ,Trxn_CEHdr.RvrsBy ")
        Query.Append("  ,REmp.fullname [CancelledByName] ")
        Query.Append("  ,FORMAT(Trxn_CEHdr.RvrsDate,'MM/dd/yyyy hh:mm tt') [RvrsDate] ")
        Query.Append("  ,isnull(Trxn_CEHdr.Rvrs, 0) [Rvrs] ")
        Query.Append("from ")
        Query.Append("  Trxn_CEHdr ")
        Query.Append("  LEFT OUTER JOIN subdivision ON Trxn_CEHdr.Subdivision = subdivision.code ")
        Query.Append("  left outer join phase [A] ON Trxn_CEHdr.Category in ('Structural Consultant - Amenities', 'Service Entrance', 'Land Scape Project Restoration', 'Land Scape Project New', 'Land Development Repair', 'Land Development New', 'DOLE Application - Land Development', 'Amenities Repair', 'Amenities New') and Trxn_CEHdr.Subdivision = [A].code ")
        Query.Append("  left outer join subdivision [B] on [A].scode = [B].code ")
        Query.Append("  left outer join eng_lot [C] on Trxn_CEHdr.Category in ('Shell to Premium', 'Shell to Complete', 'Classic to Premium', 'Shell to classic', 'Shell to Basic', 'Structural Consultant - House Unit', 'NWRB Application', 'Land Scape Unit', 'Interior Designer', 'House Repair', 'House Construction', 'Electrical Consultant', 'DOLE Application - Model House', 'Basic to Complete') and Trxn_CEHdr.Subdivision = [C].l_code ")
        Query.Append("  left outer join eng_block [D] on [C].b_code = [D].b_code ")
        Query.Append("  left outer join phase [E] on [C].p_code = [E].code ")
        Query.Append("  left outer join subdivision [F] on [C].s_code = [F].code ")
        Query.Append("  left outer join business [G] on Trxn_CEHdr.Category in ('CLDC Office') and Trxn_CEHdr.Subdivision = [G].buss_code ")
        Query.Append("  left outer join subdivision [H] on Trxn_CEHdr.Category in ('Waste Hauling Services', 'Utilities Repair', 'Testing and Investigation', 'Temporary Facilities Construction', 'Security Services', 'Container Van', 'Clearing / Grass Cutting') and Trxn_CEHdr.Subdivision = [H].code ")
        Query.Append("  LEFT JOIN employee AS UEmp on Trxn_CEHdr.UpdatedBy = UEmp.emp_no ")
        Query.Append("  LEFT JOIN employee AS LEmp on Trxn_CEHdr.LockBy = LEmp.emp_no ")
        Query.Append("  LEFT JOIN employee AS PEmp on Trxn_CEHdr.PostBy = PEmp.emp_no ")
        Query.Append("  LEFT JOIN employee as REmp on Trxn_CEHdr.RvrsBy = REmp.emp_no ")
        Query.Append("where ")
        Query.Append("  Trxn_CEHdr.CECode = '" & pID & "' ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {
                        .CECode = DR("CECode"),
                        .EstNo = DR("CENo"),
                        .EstDate = DR("CEDate"),
                        .Title = DR("Title"),
                        .Category = DR("Category"),
                        .Subdivision = DR("Subdivision"),
                        .SubdivisionName = DR("SubdivisionName"),
                        .Batch = DR("Batch"),
                        .CreatedBy = DR("CreatedBy"),
                        .CreatedDate = DR("CreatedDate"),
                        .UpdatedBy = DR("UpdatedBy"),
                        .UpdatedDate = DR("UpdatedDate"),
                        .LockedBy = DR("LockBy"),
                        .LockedDate = DR("LockedDate"),
                        .Lock = DR("Lock"),
                        .PostedBy = DR("PostBy"),
                        .PostedDate = DR("PostedDate"),
                        .Post = DR("Post"),
                        .ReversedBy = DR("RvrsBy"),
                        .ReversedDate = DR("RvrsDate"),
                        .Rvrs = DR("Rvrs"),
                        .RecordStatus = DR("RecordStatus"),
                        .UpdatedByName = DR("UpdatedByName"),
                        .LockedByName = DR("LockedByName"),
                        .PostedByName = DR("PostedByName"),
                        .CancelledByName = DR("CancelledByName")
                    })

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
    Function SCM140100_Add_Record(pCEDate, pTitle, pCategory, pProject, pBatch, pCreatedBy, pUpdatedBy)

        'insert
        Dim Query As New StringBuilder
        Query.Append("declare @ID nvarchar(13) ")
        Query.Append("declare @CENo nvarchar(13) ")
        Query.Append("exec New_Code 'Trxn_CEHdr(CECode)','MN',@ID output ")
        Query.Append("exec New_Code 'Trxn_CEHdr(CENo)','CE#',@CENo output ")
        Query.Append("INSERT INTO Trxn_CEHdr ")
        Query.Append("  (CECode ")
        Query.Append("  ,CENo ")
        Query.Append("  ,CEDate ")
        Query.Append("  ,Title ")
        Query.Append("  ,Category ")
        Query.Append("  ,Subdivision ")
        Query.Append("  ,Batch ")
        Query.Append("  ,CreatedBy ")
        Query.Append("  ,CreatedDate ")
        Query.Append("  ,UpdatedBy ")
        Query.Append("  ,UpdatedDate ")
        Query.Append("  ,Lock ")
        Query.Append("  ,Post ")
        Query.Append("  ,rvrs) ")
        Query.Append("VALUES ")
        Query.Append("  (@ID ")
        Query.Append("  ,@CENo ")
        Query.Append("  ,'" & pCEDate & "' ")
        Query.Append("  ,'" & pTitle.ToString.Replace("'", "''") & "' ")
        Query.Append("  ,'" & pCategory & "' ")
        Query.Append("  ,'" & pProject & "' ")
        Query.Append("  ,'" & pBatch & "' ")
        Query.Append("  ,'" & pCreatedBy & "' ")
        Query.Append("  ,GETDATE() ")
        Query.Append("  ,'" & pUpdatedBy & "' ")
        Query.Append("  ,GETDATE() ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,0) ")
        Query.Append("select @ID [oID] ")
        'insert

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.oID = DR("oID")})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
