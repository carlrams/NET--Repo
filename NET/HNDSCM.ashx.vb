        Query.Append("  SELECT 5, 'May' UNION ALL ")
        Query.Append("  SELECT 6, 'Jun' UNION ALL ")
        Query.Append("  SELECT 7, 'Jul' UNION ALL ")
        Query.Append("  SELECT 8, 'Aug' UNION ALL ")
        Query.Append("  SELECT 9, 'Sept' UNION ALL ")
        Query.Append("  SELECT 10, 'Oct' UNION ALL ")
        Query.Append("  SELECT 11, 'Nov' UNION ALL ")
        Query.Append("  SELECT 12, 'Dec' ")
        Query.Append(") ")
        Query.Append("SELECT ")
        Query.Append("  ISNULL(s.[Users], 0) AS [Users], ")
        Query.Append("  m.MonthName ")
        Query.Append("FROM ")
        Query.Append("  Months m ")
        Query.Append("  LEFT JOIN ( ")
        Query.Append("      SELECT ")
        Query.Append("          COUNT(*) [Users], ")
        Query.Append("          MONTH(created_date) [Month] ")
        Query.Append("      FROM ")
        Query.Append("          SCM_Contractor ")
        Query.Append("      WHERE ")
        Query.Append("          YEAR(created_date) = YEAR(GETDATE()) ")
        Query.Append("      GROUP BY ")
        Query.Append("          MONTH(created_date)) s ON m.MonthNumber = s.[Month] ")
        Query.Append("ORDER BY ")
        Query.Append("  m.MonthNumber ")
        'get chart

        'variable
        Dim RecordList As New List(Of Object)()
        Dim Users As String
        Dim Month As String
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()
                    If Users = "" Then
                        Users = DR.GetInt32(0)
                        Month = DR.GetString(1)
                    Else
                        Users = Users & "," & DR.GetInt32(0)
                        Month = Month & "," & DR.GetString(1)
                    End If
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'bind
        RecordList.Add(New With {
            .Users = Users.ToString(),
            .Month = Month.ToString()
        })
        'bind

        'display 
        Return JsonConvert.SerializeObject(RecordList, Formatting.None)
        'display

    End Function
