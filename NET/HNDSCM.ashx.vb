        Query.Append("  ,Trxn_ItemConvertion.FromTotal ")
        Query.Append("  ,Trxn_ItemConvertion.ToItemCode ")
        Query.Append("  ,TItem.item AS ToItemName ")
        Query.Append("  ,Trxn_ItemConvertion.ToQty ")
        Query.Append("  ,Trxn_ItemConvertion.ToUMCode ")
        Query.Append("  ,TUm.abbr AS ToUMName ")
        Query.Append("  ,Trxn_ItemConvertion.ToCost ")
        Query.Append("  ,Trxn_ItemConvertion.ToTotal ")
        Query.Append("  ,(case when Trxn_ItemConvertion.Lock = 1 and Trxn_ItemConvertion.Post = 0 and Trxn_ItemConvertion.rvrs = 0 then 'Locked' when Trxn_ItemConvertion.Post = 1 and Trxn_ItemConvertion.Lock = 1 and Trxn_ItemConvertion.rvrs = 0 then 'Posted' when Trxn_ItemConvertion.rvrs = 1 and Trxn_ItemConvertion.Post = 1 and Trxn_ItemConvertion.Lock = 1 then 'Cancelled' when Trxn_ItemConvertion.Lock is null and Trxn_ItemConvertion.Post = 0 and Trxn_ItemConvertion.rvrs = 0 then 'Unlocked' else 'New' end) [RecordStatus] ")
        Query.Append("  ,Trxn_ItemConvertion.CreatedBy ")
        Query.Append("  ,Trxn_ItemConvertion.CreatedDate ")
        Query.Append("  ,Trxn_ItemConvertion.UpdatedBy ")
        Query.Append("  ,UEmp.fullname [UpdatedByName] ")
        Query.Append("  ,FORMAT(Trxn_ItemConvertion.UpdatedDate,'MM/dd/yyyy hh:mm tt') [UpdatedDate] ")
        Query.Append("  ,Trxn_ItemConvertion.LockedBy ")
        Query.Append("  ,LEmp.fullname [LockedByName] ")
        Query.Append("  ,FORMAT(Trxn_ItemConvertion.LockedDate,'MM/dd/yyyy hh:mm tt') [LockedDate] ")
        Query.Append("  ,isnull(Trxn_ItemConvertion.Lock, 0) [Lock] ")
        Query.Append("  ,Trxn_ItemConvertion.PostedBy ")
        Query.Append("  ,PEmp.fullname [PostedByName] ")
