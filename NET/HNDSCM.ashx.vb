    Function SCM140100_Get_Validation_Labor(pID, pCENo, pCategory, rows)

        Dim enriched As New List(Of Dictionary(Of String, Object))()

        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            ConStr.Open()

            For Each row As Dictionary(Of String, Object) In rows
                Dim Work As String = row("Work").ToString()
                Dim WBSCode As String = row("WBSCode").ToString()
                Dim Particular As String = row("Particular").ToString()
                Dim WT As String = row("WT").ToString()
                Dim Commulative = row("Commulative").ToString()
                Dim Status As String = ""
                Dim CECode As String = pID
                Dim CENo As String = pCENo
                Dim Category As String = pCategory

                ' First validation: check against DB
                Using Cmd As New SqlCommand("
                SELECT (CASE 
                            WHEN @WBSCode IN (
                                SELECT ItemNo
                                FROM Trxn_CEDtl
                                WHERE ItemNo = @WBSCode
                                AND CECode = '" & pID & "'
                            ) THEN 'Valid'
                            WHEN @WBSCode IN (
                                SELECT ItemNo
                                FROM Trxn_CEDtl
                                WHERE ItemNo = @WBSCode
                                AND CECode = '" & pID & "'
                            ) AND (SELECT COUNT(1) FROM Trxn_CEDtl where CECode = '" & pID & "' and ItemNo = @WBSCode) > 1
                            THEN 'Invalid'
                            ELSE 'Invalid' 
                       END) AS Expr1", ConStr)

                    Cmd.Parameters.AddWithValue("@WBSCode", WBSCode)
                    Dim result = Cmd.ExecuteScalar()
                    If result IsNot Nothing Then
                        Status = result.ToString()
                    End If
                End Using

                ' Add final status into the row
                row("Status") = Status
                row("CECode") = CECode
                row("CENo") = CENo
                row("Category") = Category

                enriched.Add(row)
            Next

            ConStr.Close()
        End Using

        Return enriched
    End Function
