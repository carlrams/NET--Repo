        Query.Append("	left join employee [EM] on [SI].UpdatedBy = [EM].emp_no ")
        Query.Append("where ")
        Query.Append("	[SI].PRNo = @PRNo ")
        Query.Append("union ")
        Query.Append("select distinct ")
