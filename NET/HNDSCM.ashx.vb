    Function SCM140100_Edit_Record_Material(pID, pSeqNo, pWCode, pType, pTblCode, pParticular, pCost, pUOMCode, pQty, pTotal, pUpdatedBy)

        'update
        Dim Query As New StringBuilder
        Query.Append("UPDATE Trxn_CEDtl SET ")
        Query.Append("  WCode = '" & pWCode & "' ")
        Query.Append("  ,Tagged = (select (case when '" & pParticular & "' in (select item from ogm_item where item = '" & pParticular & "' and i_code = '" & pTblCode & "') then 1 else 0 end)) ")
        Query.Append("  ,TblFrom = '" & pType & "' ")
        Query.Append("  ,TblCode = '" & pTblCode & "' ")
        Query.Append("  ,Particular = '" & pParticular.ToString.Replace("'", "''") & "' ")
        Query.Append("  ,Cost = " & CDbl(pCost) & " ")
        Query.Append("  ,UMCode = '" & pUOMCode & "' ")
        Query.Append("  ,Qty = " & CDbl(pQty) & " ")
        Query.Append("  ,Total = " & CDbl(pTotal) & " ")
        Query.Append("  ,QtyBal = " & CDbl(pQty) & " ")
        Query.Append("  ,TotalBal = " & CDbl(pTotal) & " ")
        Query.Append("  ,UpdatedBy = '" & pUpdatedBy & "' ")
        Query.Append("  ,UpdatedDate = GETDATE() ")
        Query.Append("WHERE ")
        Query.Append("  CECode = '" & pID & "' ")
        Query.Append("  AND SeqNo = '" & pSeqNo & "' ")
        'update

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.oID = pID, .oSeqNo = pSeqNo})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
    Function SCM140100_Add_Manual_Record_Material(pID, pCategory, pCENo, pWCode, pTblCode, pParticular, pCost, pUOMCode, pQty, pTotal, pCreatedBy, pUpdatedBy)
        'add query
        Dim Query As New StringBuilder
        Query.Append("declare @pID nvarchar(13) = '" & pID & "' ")
        Query.Append("declare @pSeqNo int = (isnull((select MAX(SeqNo) from Trxn_CEDtl where CECode = @pID),0) + 1) ")
        Query.Append("INSERT INTO Trxn_CEDtl ")
        Query.Append("  (CECode ")
        Query.Append("  ,SeqNo ")
        Query.Append("  ,ItemNo ")
        Query.Append("  ,WCode ")
        Query.Append("  ,Tagged ")
        Query.Append("  ,TblFrom ")
        Query.Append("  ,TblCode ")
        Query.Append("  ,Particular ")
        Query.Append("  ,Cost ")
        Query.Append("  ,UMCode ")
        Query.Append("  ,Qty ")
        Query.Append("  ,Total ")
        Query.Append("  ,QtyRev ")
        Query.Append("  ,TotalRev ")
        Query.Append("  ,QtyBal ")
        Query.Append("  ,TotalBal ")
        Query.Append("  ,QtyReq ")
        Query.Append("  ,TotalReq ")
        Query.Append("  ,QtyPO ")
        Query.Append("  ,TotalPO ")
        Query.Append("  ,QtyUsed ")
        Query.Append("  ,TotalUsed ")
        Query.Append("  ,CreatedBy ")
        Query.Append("  ,CreatedDate ")
        Query.Append("  ,UpdatedBy ")
        Query.Append("  ,UpdatedDate) ")
        Query.Append("VALUES ")
        Query.Append("  (@pID ")
        Query.Append("  ,@pSeqNo ")
        Query.Append("  ,'" & SCM140100_Get_WBSCode(pCategory, pCENo, pID, pWCode).ToString & "' ")
        Query.Append("  ,'" & pWCode & "' ")
        Query.Append("  ,(select (case when '" & pParticular & "' in (select item from ogm_item where item = '" & pParticular & "' and i_code = '" & pTblCode & "') then 1 else 0 end)) ")
        Query.Append("  ,'ogm_item' ")
        Query.Append("  ,'" & pTblCode & "' ")
        Query.Append("  ,'" & pParticular & "' ")
        Query.Append("  ," & CDbl(pCost) & " ")
        Query.Append("  ,'" & pUOMCode & "' ")
        Query.Append("  ," & CDbl(pQty) & " ")
        Query.Append("  ," & CDbl(pTotal) & " ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ," & CDbl(pQty) & " ")
        Query.Append("  ," & CDbl(pTotal) & " ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,0 ")
        Query.Append("  ,'" & pCreatedBy & "' ")
        Query.Append("  ,GETDATE() ")
        Query.Append("  ,'" & pUpdatedBy & "' ")
        Query.Append("  ,GETDATE()) ")
        Query.Append("select @pID [oID], @pSeqNo [oSeqNo] ")
        'add query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    RecordList.Add(New With {.oID = DR("oID"), .oSeqNo = DR("oSeqNo")})

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return (New JavaScriptSerializer().Serialize(RecordList))
        'display

    End Function
    Function SCM140100_Get_WBSCode(pCategory, pCENo, pID, pWCode)

        'get query
        Dim Query As New StringBuilder
        Query.Append("declare @ItemNo nvarchar(13) ")
        Query.Append("exec New_Code 'Trxn_CEDtl(ItemNo)','MN',@ItemNo output ")
        Query.Append("declare @pID nvarchar(13) = '" & pID & "' ")
        Query.Append("declare @pSeqNo int = (isnull((select MAX(SeqNo) from Trxn_CEDtl where CECode = @pID),0) + 1) ")
        Query.Append("declare @pWNo nvarchar(60) = (select WNo from Mstr_Work where WCode = '" & pWCode & "') ")
        Query.Append("select top 1 ")
        Query.Append("  [A].Batch + '-' + [E].abbr + [D].description + 'B' + [C].block + 'L' + [B].lot + '.' + CAST(@SeqNo AS NVARCHAR) + '.' + RIGHT('000' + CAST(@pWNo AS VARCHAR(3)), 3) [WBSCode] ")
        Query.Append("  ,@ItemNo [ItemNo] ")
        Query.Append("from ")
        Query.Append("  Trxn_CEHdr [A] ")
        Query.Append("  left join eng_lot [B] on [A].Category in ('House Construction') and [A].Subdivision = [B].l_code ")
        Query.Append("  left join eng_block [C] on [B].b_code = [C].b_code ")
        Query.Append("  left join phase [D] on [B].p_code = [D].code ")
        Query.Append("  left join subdivision [E] on [B].s_code = [E].code ")
        Query.Append("  left join Trxn_CEDtl [F] on [A].CECode = [F].CECode ")
        Query.Append("  left join Mstr_Work [G] on [F].WCode = [G].WCode ")
        Query.Append("where ")
        Query.Append("  [A].CENo = '" & pCENo & "' ")
        Query.Append("order by ")
        Query.Append("  [F].SeqNo DESC ")
        'get query

        'variable
        Dim WBSCode As String
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    If pCategory = "House Construction" Then
                        WBSCode = DR("WBSCode")
                    Else
                        WBSCode = DR("ItemNo")
                    End If

                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        Return WBSCode
        'display

    End Function
