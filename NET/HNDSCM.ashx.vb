        Query.Append("  ogm_po_hdr ")
        Query.Append("  LEFT JOIN ogm_vendor ON ogm_po_hdr.vendor = ogm_vendor.v_code ")
        Query.Append("  LEFT JOIN employee ON ogm_po_hdr.updated_by = employee.emp_no ")
        Query.Append("where ")
        Query.Append("  ogm_po_hdr.post = 1 ")
        Query.Append("  AND ogm_po_hdr.Rvrs = 0 ")
        If POFrom <> "" And POTo <> "" Then
            Query.Append("  AND ogm_po_hdr.po_no between '" & POFrom & "' AND '" & POTo & "' ")
        ElseIf POFrom <> "" And POTo = "" Then
            Query.Append("  AND ogm_po_hdr.po_no = '" & POFrom & "' ")
        ElseIf POFrom = "" And POTo <> "" Then
            Query.Append("  AND ogm_po_hdr.po_no = '" & POTo & "' ")
        End If
        If DateFrom <> "" And DateTo <> "" Then
            Query.Append("  AND ogm_po_hdr.po_date between '" & DateFrom & "' AND '" & DateTo & "' ")
        ElseIf DateFrom <> "" And DateTo = "" Then
            Query.Append("  AND ogm_po_hdr.po_date = '" & DateFrom & "' ")
        ElseIf DateFrom = "" And DateTo <> "" Then
            Query.Append("  AND ogm_po_hdr.po_date = '" & DateTo & "' ")
