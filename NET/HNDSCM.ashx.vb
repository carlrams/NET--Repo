        Query.Append("  ,[lock].fullname [LockedByName] ")
        Query.Append("  ,FORMAT(ogm_wtran_hdr.LockedDate,'MM/dd/yyyy hh:mm tt') [LockedDate] ")
        Query.Append("  ,isnull(ogm_wtran_hdr.lock, 0) [Lock] ")
        Query.Append("  ,ogm_wtran_hdr.PostedBy ")
        Query.Append("  ,[post].fullname [PostedByName] ")
        Query.Append("  ,FORMAT(ogm_wtran_hdr.PostedDate,'MM/dd/yyyy hh:mm tt') [PostedDate] ")
        Query.Append("  ,isnull(ogm_wtran_hdr.post, 0) [Post] ")
        Query.Append("  ,ogm_wtran_hdr.rvrs_by [RvrsBy] ")
        Query.Append("  ,[cancel].fullname [CancelledByName] ")
        Query.Append("  ,FORMAT(ogm_wtran_hdr.rvrs_date,'MM/dd/yyyy hh:mm tt') [RvrsDate] ")
        Query.Append("  ,isnull(ogm_wtran_hdr.Rvrs, 0) [Rvrs] ")
        Query.Append("from ")
        Query.Append("  ogm_wtran_hdr ")
        Query.Append("  left join employee [req] on ogm_wtran_hdr.RequestedBy = [req].emp_no ")
        Query.Append("  left join department ON dbo.ogm_wtran_hdr.DeptCode = department.dept_code ")
        Query.Append("  left join employee [iss] ON dbo.ogm_wtran_hdr.IssuedBy = [iss].emp_no ")
        Query.Append("  left join ogm_warehouse [from] on ogm_wtran_hdr.whse_from = [from].w_code ")
        Query.Append("  left join ogm_warehouse [to] on ogm_wtran_hdr.whse_to = [to].w_code ")
        Query.Append("  left join employee [aut] ON dbo.ogm_wtran_hdr.GPAuthorizedBy = [aut].emp_no ")
        Query.Append("  left join employee [update] on ogm_wtran_hdr.UpdatedBy = [update].emp_no ")
        Query.Append("  left join employee [lock] on ogm_wtran_hdr.LockedBy = [lock].emp_no ")
        Query.Append("  left join employee [post] on ogm_wtran_hdr.PostedBy = [post].emp_no ")
        Query.Append("  left join employee [cancel] on ogm_wtran_hdr.rvrs_by = [cancel].emp_no ")
        Query.Append("where ")
        Query.Append("  ogm_wtran_hdr.wt_code = '" & pID & "' ")
        'get query

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
