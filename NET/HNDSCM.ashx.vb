        Query.Append("where ")
        Query.Append("	[PO].PRNo = @PRNo ")
        Query.Append("union ")
        Query.Append("select distinct ")
        Query.Append("	3 [SeqNo] ")
        Query.Append("	,'SI' [Type] ")
        Query.Append("	,[SI].SICode [Code] ")
        Query.Append("	,[SI].SINo [No] ")
