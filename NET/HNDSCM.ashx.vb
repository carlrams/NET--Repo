#Region "SCM060000"
    Private Function SCM060000_Purchase_Order_List(Posted As String, Vendor As String)

        'get query
        Dim Query As New StringBuilder
        Query.Append("select ")
        Query.Append("  [A].po_code [POCode] ")
        Query.Append("  ,[A].po_no [PONo] ")
        Query.Append("  ,Format([A].po_date, 'MM/dd/yyyy') [PODate] ")
        Query.Append("  ,[B].vendor [VenName] ")
        Query.Append("  ,[A].deliver_addr [DeliverTo] ")
        Query.Append("  ,isnull([A].status, '') [Status] ")
        Query.Append("  ,(case when [A].lock = 1 then 'checked' else '' end) [Lock] ")
        Query.Append("  ,(case when [A].post = 1 then 'checked' else '' end) [Post] ")
        Query.Append("  ,(case when [A].Rvrs = 1 then 'checked' else '' end) [Rvrs] ")
        Query.Append("  ,dbo.ProperCase([D].initialname) [PreparedBy] ")
        Query.Append("  ,'' [Icon] ")
        Query.Append("  ,[A].updated_by [EmpNo] ")
        Query.Append("from ")
        Query.Append("  ogm_po_hdr [A] ")
        Query.Append("  left join ogm_vendor [B] on [A].vendor = [B].v_code ")
        Query.Append("  left join ogm_warehouse [C] on [A].warehouse = [C].w_code ")
        Query.Append("  left join employee [D] on [A].updated_by = [D].emp_no ")
        Query.Append("where ")
        If Posted = 0 Then
            Query.Append("  [A].Post = 0 ")
        ElseIf Posted = 1 Then
            Query.Append("  [A].Post = 1 ")
        End If
        If Vendor <> "" Then
            Query.Append(" and [A].vendor = '" & Vendor & "' ")
        End If
        If Posted = 0 Then
            Query.Append("union ")
            Query.Append("select ")
            Query.Append("  [A].po_code [POCode] ")
            Query.Append("  ,[A].po_no [PONo] ")
            Query.Append("  ,Format([A].po_date, 'MM/dd/yyyy') [PODate] ")
            Query.Append("  ,[B].vendor [VenName] ")
            Query.Append("  ,[A].deliver_addr [DeliverTo] ")
            Query.Append("  ,isnull([A].status, '') [Status] ")
            Query.Append("  ,(case when [A].lock = 1 then 'checked' else '' end) [Lock] ")
            Query.Append("  ,(case when [A].post = 1 then 'checked' else '' end) [Post] ")
            Query.Append("  ,(case when [A].Rvrs = 1 then 'checked' else '' end) [Rvrs] ")
            Query.Append("  ,dbo.ProperCase([D].initialname) [PreparedBy] ")
            Query.Append("  ,'' [Icon] ")
            Query.Append("  ,[A].updated_by [EmpNo] ")
            Query.Append("from ")
            Query.Append("  ogm_po_hdr [A] ")
            Query.Append("  left join ogm_vendor [B] on [A].vendor = [B].v_code ")
            Query.Append("  left join ogm_warehouse [C] on [A].warehouse = [C].w_code ")
            Query.Append("  left join employee [D] on [A].updated_by = [D].emp_no ")
            Query.Append("where ")
            Query.Append("  [A].Post = 1 ")
            Query.Append("  and [A].status in ('for Cancellation', 'for Clarification', 'for Printing', 'for Re-Posting') ")
            Query.Append("order by ")
            Query.Append("  [Status] ")
        ElseIf Posted = 1 Then
            Query.Append("order by ")
            Query.Append(" [PONo] ")
        End If
        'get query

        'variable
        Dim FormList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand(Query.ToString)
                Cmd.CommandType = CommandType.Text
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()
                    Dim ID As String = "<a href='SCM060100-DTL-" & DR("POCode") & "' target='_blank' class='text-primary'>" & DR("POCode") & "</a>"
                    Dim Lock As String = "<div class='d-flex justify-content-center form-check form-check-sm form-check-custom form-check-solid'><input class='form-check-input widget-9-check' type='checkbox' " & DR("Lock") & " onclick='return false;' /></div>"
                    Dim Post As String = "<div class='d-flex justify-content-center form-check form-check-sm form-check-custom form-check-solid'><input class='form-check-input widget-9-check' type='checkbox' " & DR("Post") & " onclick='return false;' /></div>"
                    Dim Rvrs As String = "<div class='d-flex justify-content-center form-check form-check-sm form-check-custom form-check-solid'><input class='form-check-input widget-9-check' type='checkbox' " & DR("Rvrs") & " onclick='return false;' /></div>"
                    Dim VenName As String = "<div class='d-flex align-items-center'><div Class='symbol symbol-20px'><img alt='' class='w-100' src='" & DR("Icon") & "' /></div>&nbsp" & DR("VenName") & "</div>"
                    Dim PreparedBy As String = "<div class='d-flex align-items-center'><div Class='symbol symbol-20px symbol-circle'><div Class='symbol-label' style='background-image:url(Assets/media/avatars/" & DR("EmpNo") & ".png)'></div></div>&nbsp" & DR("PreparedBy") & "</div>"

                    FormList.Add(New With {
                        .ID = ID.ToString,
                        .Lock = Lock.ToString,
                        .Post = Post.ToString,
                        .Rvrs = Rvrs.ToString,
                        .PONo = DR("PONo"),
                        .PODate = DR("PODate"),
                        .Status = DR("Status"),
                        .VenName = DR("VenName"),
                        .DeliverTo = DR("DeliverTo"),
                        .PreparedBy = PreparedBy.ToString
                    })
                End While
                DR.Close()
                ConStr.Close()
            End Using
        End Using
        'read record

        'display 
        'Return (New JavaScriptSerializer().Serialize(FormList))

        'set to max
        Return JsonConvert.SerializeObject(FormList, Formatting.None)
        'display 

    End Function
    Function SCM060000_Get_Record(pPosted, pVendor)

        'variable
        Dim RecordList As New List(Of Object)()
        'variable

        'read record
        Using ConStr As New SqlConnection("Data Source=" & DataSource & "; Initial Catalog=" & catalog & "; User ID=" & UserID & "; Password=" & Password)
            Using Cmd As New SqlCommand("Get_POHdrList")
                Cmd.CommandType = CommandType.StoredProcedure
                Cmd.Parameters.AddWithValue("@pPost", IIf(pPosted = True, 1, 0))
                Cmd.Parameters.AddWithValue("@pVenCode", pVendor)
                Cmd.Connection = ConStr
                ConStr.Open()
                Dim DR As SqlDataReader = Cmd.ExecuteReader
                While DR.Read()

                    Dim Action As New StringBuilder
                    Action.Append("<div class='action-toggle-wrapper mt-1' style='position: relative; display: inline-block;'>")
